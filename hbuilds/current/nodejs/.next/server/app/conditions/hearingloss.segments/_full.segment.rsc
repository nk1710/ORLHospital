1b:["$","div",null,{"className":"number-item","children":[["$","span",null,{"children":"04"}],["$","div",null,{"children":[["$","h3",null,{"children":"Hearing Loss in One Ear"}],["$","p",null,{"children":"Hearing may be reduced in only one ear. One-sided hearing changes should be evaluated to identify the underlying cause."}]]}]]}]
