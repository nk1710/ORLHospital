1d:["$","section",null,{"className":"content-section","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"split-section","children":[["$","div",null,{"className":"split-image","children":["$","img",null,{"src":"/images/mastoidectomy.webp","alt":"Signs that may indicate hearing loss","loading":"lazy"}]}],["$","div",null,{"className":"split-content","children":[["$","span",null,{"className":"section-label","children":"Early Signs"}],["$","h2",null,{"children":"How Can You Identify That You Are Losing Your Hearing?"}],["$","p",null,{"children":"Hearing loss can develop so gradually that you may not notice it immediately. Family members may sometimes recognize the changes before you do."}],["$","div",null,{"className":"check-grid","children":[["$","div",null,{"children":"✓ Frequently asking people to repeat themselves"}],["$","div",null,{"children":"✓ Increasing TV or phone volume"}],["$","div",null,{"children":"✓ Feeling that people are mumbling"}],["$","div",null,{"children":"✓ Difficulty hearing in crowded places"}],["$","div",null,{"children":"✓ Difficulty understanding conversations"}],["$","div",null,{"children":"✓ Trouble hearing on the telephone"}],["$","div",null,{"children":"✓ Depending heavily on subtitles"}],["$","div",null,{"children":"✓ Difficulty hearing from another room"}]]}],["$","div",null,{"className":"highlight-box","children":["$","strong",null,{"children":"If you regularly ask others to repeat themselves or keep increasing the volume of your TV or phone, consider getting your hearing evaluated."}]}]]}]]}]}]}]
