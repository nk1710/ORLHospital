11:["$","$1","c",{"children":[["$","main",null,{"className":"hearing-page","children":[["$","section",null,{"className":"hearing-hero","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"hero-top","children":["$","h1",null,{"children":"Hearing Loss: Types, Symptoms, Causes, Prevention, Treatment & When to See an ENT Doctor"}]}]}]}],["$","section",null,{"className":"hearing-hero","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"hero-grid","children":[["$","div",null,{"className":"hero-content","children":[["$","p",null,{"className":"hero-intro","children":"Hearing loss can develop gradually or occur suddenly and may affect communication, work, education and everyday life. Identifying the underlying cause through an ENT evaluation and appropriate hearing assessment can help determine the right treatment or hearing rehabilitation approach."}],["$","div",null,{"className":"hero-actions","children":[["$","$L19",null,{"href":"/contact","className":"primary-btn","children":"Book a Hearing Consultation"}],["$","$L19",null,{"href":"/about","className":"secondary-btn","children":"Meet Dr.(Prof.) Dhirendra Singh Kushwah"}]]}],["$","div",null,{"className":"hero-points","children":[["$","span",null,{"children":"✓ ENT Evaluation"}],["$","span",null,{"children":"✓ Hearing Assessment"}],["$","span",null,{"children":"✓ Medical & Surgical Care"}]]}]]}],["$","div",null,{"className":"hero-image","children":["$","img",null,{"src":"/images/banner/dhirendra kushwah.webp","alt":"ENT specialist evaluating hearing loss"}]}]]}]}]}],["$","section",null,{"className":"content-section","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"split-section","children":[["$","div",null,{"className":"split-image","children":["$","img",null,{"src":"/images/blog4.jpg","alt":"Ear anatomy and hearing loss","loading":"lazy"}]}],["$","div",null,{"className":"split-content","children":[["$","span",null,{"className":"section-label","children":"Understanding Hearing Loss"}],["$","h2",null,{"children":"What Is Hearing Loss?"}],["$","p",null,{"children":"Hearing loss means a reduced ability to hear sounds clearly in one or both ears. It can range from mild difficulty hearing conversations to severe or profound hearing impairment."}],["$","p",null,{"children":"Hearing loss may develop gradually over time or occur suddenly. It can result from problems affecting the outer ear, middle ear, inner ear or auditory nerve."}],["$","p",null,{"children":"Some causes of hearing loss may be temporary or treatable, while others may require long-term hearing rehabilitation or specialist treatment."}],["$","div",null,{"className":"highlight-box","children":["$","strong",null,{"children":"Persistent, progressive or sudden hearing loss should be evaluated by an ENT specialist."}]}]]}]]}]}]}],["$","section",null,{"className":"content-section section-soft","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"split-section reverse-mobile","children":[["$","div",null,{"className":"split-content","children":[["$","span",null,{"className":"section-label","children":"Types"}],["$","h2",null,{"children":"Types of Hearing Loss"}],["$","p",null,{"children":"Hearing loss can be classified according to the part of the hearing system affected. Identifying the type helps an ENT specialist determine the appropriate treatment or rehabilitation approach."}],["$","div",null,{"className":"number-list","children":[["$","div",null,{"className":"number-item","children":[["$","span",null,{"children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Conductive Hearing Loss"}],["$","p",null,{"children":"Occurs when sound cannot travel efficiently through the outer or middle ear. Earwax blockage, ear infections, eardrum problems and certain middle-ear conditions may cause conductive hearing loss."}]]}]]}],["$","div",null,{"className":"number-item","children":[["$","span",null,{"children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Sensorineural Hearing Loss"}],["$","p",null,{"children":"This type involves the inner ear or auditory nerve. Age-related changes, prolonged noise exposure and other conditions affecting the inner ear may contribute to it."}]]}]]}],"$L1a","$L1b"]}]]}],"$L1c"]}]}]}],"$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}],["$L2c"],"$L2d"]}]
