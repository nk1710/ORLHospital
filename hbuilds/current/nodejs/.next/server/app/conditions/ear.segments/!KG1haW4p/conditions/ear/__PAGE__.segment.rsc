0:{"buildId":"build-1789436362807","rsc":["$","$1","c",{"children":[["$","div",null,{"className":"bg-white","children":[["$","section",null,{"className":"relative bg-slate-900 py-20 px-4 md:px-8 overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 opacity-20","children":[["$","div",null,{"className":"absolute top-0 left-0 w-96 h-96 bg-teal-500 rounded-full blur-[120px] -translate-x-1/2 -translate-y-1/2"}],["$","div",null,{"className":"absolute bottom-0 right-0 w-96 h-96 bg-blue-500 rounded-full blur-[120px] translate-x-1/2 translate-y-1/2"}]]}],["$","div",null,{"className":"max-w-7xl mx-auto relative z-10","children":["$","div",null,{"className":"flex flex-col gap-6","children":[["$","span",null,{"className":"text-teal-400 font-bold uppercase tracking-[0.2em] text-xs","children":"Otology & Ear Health — New Delhi"}],["$","h1",null,{"className":"text-4xl md:text-6xl font-bold text-white leading-tight max-w-4xl","children":"H1: Ear & Hearing Conditions — Expert Diagnosis and Treatment in New Delhi"}],["$","p",null,{"className":"text-gray-300 text-lg max-w-3xl leading-relaxed","children":"Ear problems are among the most common health concerns affecting people of all ages — yet they are also among the most under-treated. Whether you are dealing with recurring ear infections, unexplained hearing loss, a persistent ringing sound, or a sensation of spinning, the root cause almost always lies in the delicate structures of the ear and its connected systems."}],["$","p",null,{"className":"text-gray-300 text-lg max-w-3xl leading-relaxed","children":"Dr. Dhirendra Singh kushwah is a senior ENT and otology specialist based in New Delhi with over 25 years of clinical and surgical experience. He diagnoses and treats the full range of ear and hearing conditions in children, adults, and the elderly — from simple infections to complex cochlear implant surgeries — using advanced, minimally invasive techniques designed for lasting relief."}]]}]}]]}],["$","section",null,{"className":"py-16 px-4 md:px-8 bg-gray-50","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-12 items-center","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-800","children":"H2: What Is Otology? Understanding the Science of Ear Health"}],["$","div",null,{"className":"w-16 h-1 bg-teal-600 rounded"}],["$","p",null,{"className":"text-gray-600 text-lg leading-relaxed","children":"Otology is the branch of medicine dedicated to the anatomy, function, and diseases of the ear. An otologist — also called an ear specialist or otology surgeon — is trained to manage conditions affecting the outer ear, middle ear, inner ear, hearing nerve, and the balance system."}],["$","p",null,{"className":"text-gray-600 text-lg leading-relaxed","children":"Unlike a general ENT doctor, an otology specialist has advanced training in microsurgery of the ear, cochlear implantation, and neuro-otology. This depth of expertise is essential when dealing with conditions that affect hearing, balance, and quality of life at a fundamental level."}]]}],["$","div",null,{"className":"bg-teal-50 border-l-4 border-teal-600 p-6 rounded-r-xl","children":["$","p",null,{"className":"text-teal-900 font-medium italic","children":"\"Precision is paramount in ear surgery. The structures we work with are measured in millimeters, and the impact on a patient's life is measured in years of better hearing.\""}]}]]}]}]}],["$","section",null,{"className":"py-20 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":[["$","div",null,{"className":"text-center mb-12","children":"$L2"}],"$L3"]}]}],"$L4","$L5","$L6","$L7","$L8","$L9"]}],["$La"],"$Lb"]}],"loading":null,"isPartial":false}
2:["$","h2",null,{"className":"text-3xl font-bold text-gray-900","children":"H2: Ear & Hearing Conditions Treated by Dr.(Prof.) Dhirendra Singh Kushwah"}]
3:["$","div",null,{"className":"space-y-12","children":[["$","div",null,{"className":"border-b border-gray-200 pb-8","children":[["$","h3",null,{"className":"text-xl font-bold text-teal-700 mb-3","children":"H3: Chronic Ear Infections (Chronic Otitis Media)"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Chronic otitis media is a persistent or recurrent infection of the middle ear, often associated with a perforated eardrum and continuous ear discharge. Left untreated, it can lead to progressive hearing loss, mastoid bone damage, and in rare cases, serious intracranial complications."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mt-2","children":"Dr.(Prof.) Dhirendra Singh Kushwah evaluates each case using video endoscopy and microscopy, and tailors treatment — medical or surgical — based on the severity and duration of the infection."}]]}],["$","div",null,{"className":"border-b border-gray-200 pb-8","children":[["$","h3",null,{"className":"text-xl font-bold text-teal-700 mb-3","children":"H3: Eardrum Perforation (Tympanic Membrane Perforation)"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"A hole or tear in the eardrum can result from chronic infection, a sudden pressure change (barotrauma), direct injury, or a previous surgery. Symptoms include hearing loss, recurrent discharge, and susceptibility to further infections."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mt-2","children":"Tympanoplasty — surgical repair of the eardrum — is performed by Dr.(Prof.) Dhirendra Singh Kushwah under high-magnification operating microscopy, with high success rates and minimal downtime. The procedure restores the integrity of the eardrum and significantly improves hearing."}]]}],["$","div",null,{"className":"border-b border-gray-200 pb-8","children":[["$","h3",null,{"className":"text-xl font-bold text-teal-700 mb-3","children":"H3: Cholesteatoma"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Cholesteatoma is an abnormal growth of skin cells within the middle ear or mastoid bone. Though not cancerous, it is destructive — it erodes the ossicles, mastoid bone, and can eventually invade the inner ear or skull base if untreated."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mt-2","children":"Symptoms include a foul-smelling ear discharge, progressive hearing loss, and sometimes dizziness or facial weakness. Treatment is surgical: mastoidectomy with or without reconstruction of the hearing mechanism (ossiculoplasty)."}]]}],["$","div",null,{"className":"border-b border-gray-200 pb-8","children":[["$","h3",null,{"className":"text-xl font-bold text-teal-700 mb-3","children":"H3: Hearing Loss — Conductive, Sensorineural, and Mixed"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Hearing loss is classified into three types based on where in the auditory pathway the problem lies:"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mt-2","children":"Conductive hearing loss occurs when sound cannot travel efficiently from the outer ear to the inner ear — commonly caused by earwax blockage, fluid in the middle ear, eardrum perforation, or ossicular chain disruption. It is often treatable with surgery or medical management."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mt-2","children":"Sensorineural hearing loss results from damage to the hair cells of the cochlea or the auditory nerve — caused by ageing (presbycusis), prolonged noise exposure, viral infections, ototoxic medications, or genetic factors. Mild to moderate cases are managed with hearing aids; severe to profound cases may require a cochlear implant."}],"$Lc","$Ld"]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14"]}]
4:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-gray-50","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-6 text-center","children":"H2: Warning Signs — When to See an Ear Specialist"}],["$","p",null,{"className":"text-gray-700 text-center max-w-3xl mx-auto mb-8","children":"Do not ignore ear symptoms. Seek expert evaluation if you or your child experiences any of the following:"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto","children":[["$","div",null,{"className":"bg-white p-4 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":"Hearing loss in one or both ears — sudden or gradual."}]}],["$","div",null,{"className":"bg-white p-4 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":"Persistent ear discharge, especially if foul-smelling."}]}],["$","div",null,{"className":"bg-white p-4 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":"A ringing, buzzing, or hissing sound in the ear."}]}],["$","div",null,{"className":"bg-white p-4 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":"Recurring ear infections, especially in children."}]}],["$","div",null,{"className":"bg-white p-4 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":"Earache or feeling of pressure or fullness."}]}],["$","div",null,{"className":"bg-white p-4 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":"Dizziness, spinning sensations, or balance problems."}]}],["$","div",null,{"className":"bg-white p-4 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":"Blockage or muffled hearing that does not resolve on its own."}]}],["$","div",null,{"className":"bg-white p-4 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":"Facial weakness or numbness alongside ear symptoms."}]}]]}],["$","p",null,{"className":"text-teal-700 font-medium text-center mt-8","children":"Early diagnosis almost always leads to better outcomes and fewer complications."}]]}]}]
5:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-4 text-center","children":"H2: Ear Surgeries Performed by Dr.(Prof.) Dhirendra Singh Kushwah"}],["$","p",null,{"className":"text-gray-600 text-center max-w-2xl mx-auto mb-10","children":"Dr.(Prof.) Dhirendra Singh Kushwah is an experienced ear surgeon performing a wide range of microsurgical and reconstructive procedures:"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-6","children":[["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Tympanoplasty"}]," — repair of a perforated eardrum, with or without ossicular chain reconstruction."]}]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Mastoidectomy"}]," — surgical removal of diseased mastoid bone, performed for cholesteatoma, chronic mastoiditis, and complications of chronic ear disease."]}]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Ossiculoplasty"}]," — reconstruction of the tiny hearing bones (ossicles) damaged by infection, cholesteatoma, or trauma, using prosthetic implants or the patient's own tissue."]}]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Stapedotomy"}]," — microsurgical procedure for otosclerosis, creating a small opening in the fixed stapes and placing a prosthesis to restore sound transmission."]}]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Cochlear Implantation"}]," — surgical placement of an electronic device that directly stimulates the auditory nerve, restoring meaningful hearing in patients with severe to profound sensorineural hearing loss."]}]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Intratympanic Injections"}]," — targeted injection of steroids or gentamicin directly into the middle ear, used for sudden hearing loss, Menière's disease, and refractory tinnitus."]}]}]]}]]}]}]
6:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-gray-50","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-4 text-center","children":"H2: Hearing Tests and Audiological Evaluation"}],["$","p",null,{"className":"text-gray-600 text-center max-w-2xl mx-auto mb-10","children":"Before any treatment is recommended, every patient undergoes a structured hearing assessment. The following tests are available at the clinic:"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto","children":[["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Pure Tone Audiogram (PTA)"}]," identifies the degree and type of hearing loss across all frequencies."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Speech Audiogram"}]," measures how clearly a person can hear and understand spoken words — reflecting real-world functional hearing ability."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Tympanometry"}]," checks the mobility of the eardrum and detects middle ear fluid, Eustachian tube dysfunction, or ossicular problems."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Auditory Brainstem Response (ABR)"}]," records the brain's electrical response to sound — used for infants, newborns, and uncooperative patients who cannot complete standard tests."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Auditory Steady-State Response (ASSR)"}]," provides frequency-specific thresholds essential for planning cochlear implant candidacy in young children."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Otoacoustic Emissions (OAE)"}]," tests outer hair cell function in the cochlea — a quick, objective, and non-invasive screening tool."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Newborn Hearing Screening"}]," — OAE and ABR-based screening to detect hearing loss at birth and trigger early intervention before the critical language development window closes."]}]}]]}]]}]}]
7:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center","children":[["$","div",null,{"className":"relative","children":[["$","div",null,{"className":"absolute -inset-4 bg-teal-500/10 rounded-[40px] rotate-3"}],["$","$L15",null,{"src":"images/dherendra_patient.png","alt":"Dr.(Prof.) Dhirendra Singh Kushwah – ENT Specialist","className":"relative rounded-[32px] shadow-2xl"}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-6","children":"H2: Why Patients Choose Dr. Dhirendra Singh kushwah for Ear Treatment"}],["$","div",null,{"className":"space-y-4 text-gray-700","children":[["$","p",null,{"children":"Dr.(Prof.) Dhirendra Singh kushwah completed his MBBS from Jiwaji University, Gwalior (1999) and his MS in ENT from Rani Durgawati University, Jabalpur (2005). He has been practising and operating in New Delhi for over two decades and is recognised as one of India's most trusted ear surgeons."}],["$","p",null,{"children":"Patients choose Dr.(Prof.) Dhirendra Singh kushwah for ear and hearing treatment because of his precision surgical technique, transparent communication, and genuine commitment to every patient's recovery — whether they are a newborn undergoing hearing screening or an adult seeking cochlear implantation after years of profound hearing loss."}],["$","p",null,{"children":"He is available in English and Hindi, personally reachable at all hours, and operates from two conveniently located clinics in New Delhi."}],["$","p",null,{"className":"font-medium","children":"Over 700 cochlear and auditory brainstem implant recipients under his care — one of the highest programme volumes in India."}]]}]]}]]}]}]}]
8:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-gray-50","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-4 text-center","children":" Frequently Asked Questions About Ear & Hearing Conditions"}],["$","div",null,{"className":"max-w-3xl mx-auto space-y-4 mt-8","children":[["$","div",null,{"className":"bg-white p-6 rounded-2xl shadow-sm","children":[["$","p",null,{"className":"font-bold text-gray-800","children":"What is the difference between an ENT doctor and an otologist?"}],["$","p",null,{"className":"text-gray-600 mt-2","children":"An ENT (Ear, Nose and Throat) specialist treats all three areas of the head and neck. An otologist is an ENT who has undergone additional specialised training exclusively in ear diseases, hearing, and balance — including microsurgery and cochlear implantation. Dr. kushwah practises as both a senior ENT and an experienced otologist."}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl shadow-sm","children":[["$","p",null,{"className":"font-bold text-gray-800","children":"Can hearing loss be cured?"}],["$","p",null,{"className":"text-gray-600 mt-2","children":"Conductive hearing loss — caused by eardrum perforation, fluid, or ossicular damage — is often curable with surgery. Sensorineural hearing loss caused by cochlear damage is generally not reversible, but can be highly effectively managed with hearing aids or cochlear implants, restoring functional hearing."}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl shadow-sm","children":[["$","p",null,{"className":"font-bold text-gray-800","children":"Is tympanoplasty a major surgery?"}],["$","p",null,{"className":"text-gray-600 mt-2","children":"Tympanoplasty is performed under general or local anaesthesia and typically takes one to two hours. It is not considered a major surgery, but it is microsurgical — requiring great precision. Most patients are discharged the same day or after one night's observation, with full recovery in four to six weeks."}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl shadow-sm","children":[["$","p",null,{"className":"font-bold text-gray-800","children":"At what age can a child receive a cochlear implant?"}],["$","p",null,{"className":"text-gray-600 mt-2","children":"Cochlear implants can be placed in children as young as 12 months of age — and earlier in cases of bilateral profound hearing loss where medical urgency is established. The earlier the implant, the better the child's prospects for natural speech and language development."}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl shadow-sm","children":[["$","p",null,{"className":"font-bold text-gray-800","children":"Is stapedotomy safe? What are the risks?"}],["$","p",null,{"className":"text-gray-600 mt-2","children":"Stapedotomy is a highly refined procedure with excellent outcomes in experienced hands. In a small number of cases there is a risk of inner ear damage leading to sensorineural hearing loss - which is why it should only be performed by a specialist with significant experience. Dr. kushwah has performed this procedure extensively with high success rates."}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl shadow-sm","children":[["$","p",null,{"className":"font-bold text-gray-800","children":"What causes sudden hearing loss in one ear?"}],["$","p",null,{"className":"text-gray-600 mt-2","children":"Sudden sensorineural hearing loss (SSNHL) can result from viral infection, vascular disruption to the cochlea, autoimmune conditions, or perilymph fistula. In many cases the exact cause is not found. It is a medical emergency — seek evaluation within 24-48 hours for the best chance of recovery."}]]}],"$L16"]}]]}]}]
9:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-4xl mx-auto bg-teal-600 rounded-[40px] p-8 md:p-12 text-center shadow-2xl","children":[["$","h2",null,{"className":"text-3xl md:text-4xl font-bold text-white mb-4","children":"H2: Book an Appointment with Dr. Dhirendra Singh kushwah"}],["$","p",null,{"className":"text-teal-100 text-lg mb-6","children":"If you are experiencing any ear or hearing concern - however mild it may seem - early expert assessment leads to better outcomes. Dr. kushwah and his team are available six days a week at two New Delhi locations."}],["$","div",null,{"className":"space-y-2 text-white","children":[["$","p",null,{"className":"text-xl font-semibold","children":"Call or WhatsApp: +91-9311449825"}],["$","p",null,{"children":"Email: drdhirendrasinghent@gmail.com"}],["$","div",null,{"className":"mt-6 pt-4 border-t border-teal-400/30","children":[["$","p",null,{"children":[["$","strong",null,{"children":"CR Park Clinic:"}]," J-1981, Near Market No. 1, Below ICICI Bank, Bipin Chandra Pal Marg, CR Park, New Delhi – 110019"]}],["$","p",null,{"className":"mt-2","children":[["$","strong",null,{"children":"Arjun Nagar Clinic:"}]," 19-C, Arjun Nagar, Safdarjung Enclave, New Delhi – 110029"]}]]}]]}],["$","div",null,{"className":"flex flex-wrap justify-center gap-4 mt-8","children":[["$","a",null,{"href":"tel:+919311449825","className":"bg-white text-teal-700 px-8 py-3 rounded-full font-bold shadow-lg hover:bg-gray-100 transition-all","children":"Call Now"}],["$","a",null,{"href":"https://wa.me/919311449825","className":"bg-teal-700 text-white px-8 py-3 rounded-full font-bold shadow-lg hover:bg-teal-800 transition-all","children":"WhatsApp"}]]}]]}]}]
