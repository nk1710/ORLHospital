{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/pages/layout,_N_T_/dashboard/pages/page,_N_T_/dashboard/pages"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/pages/__PAGE__",
    "/dashboard/pages",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}