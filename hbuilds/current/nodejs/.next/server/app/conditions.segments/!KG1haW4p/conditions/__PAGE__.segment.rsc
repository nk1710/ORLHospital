0:{"buildId":"build-1789436362807","rsc":["$","$1","c",{"children":[["$","div",null,{"className":"bg-white","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":[\"MedicalCondition\",\"Physician\",\"FAQPage\"],\"name\":\"Ear & Hearing Conditions\",\"description\":\"Expert diagnosis and treatment for ear and hearing conditions by Dr.(Prof.) Dhirendra Singh kushwah, senior ENT and otology specialist in New Delhi.\",\"physician\":{\"@type\":\"Physician\",\"name\":\"Dr.(Prof.) Dhirendra Singh kushwah\",\"image\":\"https://staging.drdhirendrasinghkushwah.in/images/dherendra_patient.png\",\"medicalSpecialty\":\"Otology\",\"description\":\"Senior ENT and otology specialist in New Delhi with over 25 years of experience. Over 700 cochlear and auditory brainstem implant recipients under his care.\"}}"}}],["$","section",null,{"className":"relative bg-slate-900 py-20 px-4 md:px-8 overflow-hidden","children":["$","div",null,{"className":"max-w-7xl mx-auto relative z-10","children":["$","div",null,{"className":"flex flex-col gap-6","children":[["$","span",null,{"className":"text-teal-400 font-bold uppercase tracking-[0.2em] text-xs","children":"Otology & Ear Health — New Delhi"}],["$","h1",null,{"className":"text-4xl md:text-6xl font-bold text-white leading-tight max-w-5xl","children":["Ear & Hearing Conditions — ",["$","br",null,{}],["$","span",null,{"className":"text-teal-400","children":"Expert Diagnosis and Treatment in New Delhi"}]]}],["$","p",null,{"className":"text-gray-300 text-lg max-w-3xl leading-relaxed","children":"Ear problems are among the most common health concerns affecting people of all ages — yet they are also among the most under-treated. Whether you are dealing with recurring ear infections, unexplained hearing loss, a persistent ringing sound, or a sensation of spinning, the root cause almost always lies in the delicate structures of the ear and its connected systems."}],["$","p",null,{"className":"text-gray-400 max-w-3xl","children":"Dr.(Prof.) Dhirendra Singh kushwah is a senior ENT and otology specialist based in New Delhi with over 25 years of clinical and surgical experience. He diagnoses and treats the full range of ear and hearing conditions in children, adults, and the elderly — from simple infections to complex cochlear implant surgeries — using advanced, minimally invasive techniques designed for lasting relief."}],["$","div",null,{"className":"flex flex-wrap gap-4 mt-4","children":[["$","div",null,{"className":"flex items-center gap-2 bg-white/5 border border-white/10 px-4 py-2 rounded-full text-white text-sm","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-award text-teal-400","aria-hidden":"true","children":[["$","path","1yiouv",{"d":"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"}],["$","circle","1vp47v",{"cx":"12","cy":"8","r":"6"}],"$undefined"]}]," 25+ Years Experience"]}],["$","div",null,{"className":"flex items-center gap-2 bg-white/5 border border-white/10 px-4 py-2 rounded-full text-white text-sm","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-headphones text-teal-400","aria-hidden":"true","children":[["$","path","1xhozi",{"d":"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"}],"$undefined"]}]," 700+ Cochlear Implants"]}]]}]]}]}]}],"$L2","$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La"]}],["$Lb"],"$Lc"]}],"loading":null,"isPartial":false}
2:["$","section",null,{"className":"py-8 px-4 md:px-8 bg-red-50 border-b border-red-100","children":["$","div",null,{"className":"max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-6","children":[["$","div",null,{"className":"bg-red-600 p-3 rounded-2xl text-white animate-pulse","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":28,"height":28,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-shield-alert","aria-hidden":"true","children":[["$","path","oel41y",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"}],["$","path","1got3b",{"d":"M12 8v4"}],["$","path","1drbdi",{"d":"M12 16h.01"}],"$undefined"]}]}],["$","div",null,{"children":[["$","h2",null,{"className":"text-xl font-bold text-red-900","children":"Sudden Sensorineural Hearing Loss (SSNHL)"}],["$","p",null,{"className":"text-red-700 text-sm","children":[["$","strong",null,{"children":"Medical emergency:"}]," Sudden sensorineural hearing loss is a medical emergency — a rapid, unexplained loss of hearing, typically in one ear, that occurs within 72 hours. It requires urgent assessment and treatment, as delay significantly worsens prognosis. If you or someone you know experiences sudden hearing loss, especially accompanied by tinnitus or dizziness, contact Dr.(Prof.) Dhirendra Singh kushwah's clinic immediately. Early treatment with corticosteroids (oral or intratympanic) offers the best chance of recovery."]}]]}],["$","a",null,{"href":"tel:+919311449825","className":"md:ml-auto bg-white-600 text-white px-6 py-3 rounded-full font-bold hover:bg-red-700 transition-all text-sm whitespace-nowrap","children":"Contact Clinic Immediately"}]]}]}]
3:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-12 items-center","children":[["$","div",null,{"className":"flex flex-col gap-6","children":[["$","h2",null,{"className":"text-3xl font-bold text-slate-900","children":"What Is Otology? Understanding the Science of Ear Health"}],["$","div",null,{"className":"w-16 h-1 bg-teal-600 rounded"}],["$","p",null,{"className":"text-slate-600 leading-relaxed","children":"Otology is the branch of medicine dedicated to the anatomy, function, and diseases of the ear. An otologist — also called an ear specialist or otology surgeon — is trained to manage conditions affecting the outer ear, middle ear, inner ear, hearing nerve, and the balance system."}],["$","p",null,{"className":"text-slate-600 leading-relaxed","children":"Unlike a general ENT doctor, an otology specialist has advanced training in microsurgery of the ear, cochlear implantation, and neuro-otology. This depth of expertise is essential when dealing with conditions that affect hearing, balance, and quality of life at a fundamental level."}]]}],["$","div",null,{"className":"bg-slate-50 p-8 rounded-[40px] border border-slate-100","children":["$","div",null,{"className":"space-y-4","children":[["$","div",null,{"className":"flex items-start gap-4","children":[["$","div",null,{"className":"w-8 h-8 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center flex-shrink-0 mt-1","children":"1"}],["$","div",null,{"children":["$","p",null,{"className":"text-slate-700 font-medium","children":"Advanced training in microsurgery of the ear"}]}]]}],["$","div",null,{"className":"flex items-start gap-4","children":[["$","div",null,{"className":"w-8 h-8 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center flex-shrink-0 mt-1","children":"2"}],["$","div",null,{"children":["$","p",null,{"className":"text-slate-