12:["$","div",null,{"className":"mt-12 bg-slate-900 rounded-[40px] p-8 md:p-12 text-white","children":[["$","h3",null,{"className":"text-2xl font-bold mb-8 text-teal-400","children":"Hearing Loss — Conductive, Sensorineural, and Mixed"}],["$","p",null,{"className":"text-slate-300 mb-6","children":"Hearing loss is classified into three types based on where in the auditory pathway the problem lies:"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-3 gap-8","children":[["$","div",null,{"className":"bg-white/5 p-6 rounded-2xl","children":[["$","h4",null,{"className":"font-bold text-lg mb-2 text-teal-300","children":"Conductive Hearing Loss"}],["$","p",null,{"className":"text-slate-400 text-sm leading-relaxed","children":"Occurs when sound cannot travel efficiently from the outer ear to the inner ear — commonly caused by earwax blockage, fluid in the middle ear, eardrum perforation, or ossicular chain disruption. It is often treatable with surgery or medical management."}]]}],["$","div",null,{"className":"bg-white/5 p-6 rounded-2xl","children":[["$","h4",null,{"className":"font-bold text-lg mb-2 text-teal-300","children":"Sensorineural Hearing Loss"}],["$","p",null,{"className":"text-slate-400 text-sm leading-relaxed","children":"Results from damage to the hair cells of the cochlea or the auditory nerve — caused by ageing (presbycusis), prolonged noise exposure, viral infections, ototoxic medications, or genetic factors. Mild to moderate cases are managed with hearing aids; severe to profound cases may require a cochlear implant."}]]}],["$","div",null,{"className":"bg-white/5 p-6 rounded-2xl","children":[["$","h4",null,{"className":"font-bold text-lg mb-2 text-teal-300","children":"Mixed Hearing Loss"}],["$","p",null,{"className":"text-slate-400 text-sm leading-relaxed","children":"Involves both conductive and sensorineural components and requires a combined treatment approach."}]]}]]}],["$","p",null,{"className":"mt-6 text-xs text-slate-500 italic","children":"A full audiological evaluation — including Pure Tone Audiogram (PTA), Speech Audiogram, and Tympanometry — is performed at the clinic to classify the type and degree of hearing loss before any treatment is recommended."}]]}]
