8:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto bg-teal-900 rounded-[48px] p-8 md:p-20 text-white flex flex-col md:flex-row gap-12 items-center","children":[["$","div",null,{"className":"w-full md:w-1/3 text-center","children":[["$","div",null,{"className":"aspect-square bg-teal-800 rounded-3xl flex items-center justify-center border-4 border-teal-700 shadow-inner","children":["$","div",null,{"className":"text-center","children":[["$","span",null,{"className":"text-6xl font-bold","children":"700+"}],["$","p",null,{"className":"text-sm mt-2 text-teal-300","children":["Cochlear & Auditory",["$","br",null,{}],"Brainstem Implants"]}]]}]}],["$","p",null,{"className":"text-center mt-4 font-bold text-teal-400 uppercase tracking-widest text-xs","children":"One of the highest programme volumes in India"}]]}],["$","div",null,{"className":"flex-1","children":[["$","h2",null,{"className":"text-3xl font-bold mb-6","children":"Why Patients Choose Dr.(Prof.) Dhirendra Singh kushwah for Ear Treatment"}],["$","div",null,{"className":"w-12 h-1 bg-teal-400 mb-8 rounded"}],["$","p",null,{"className":"text-teal-50 leading-relaxed mb-4","children":"Dr.(Prof.) Dhirendra Singh kushwah completed his MBBS from Jiwaji University, Gwalior (1999) and his MS in ENT from Rani Durgawati University, Jabalpur (2005). He has been practising and operating in New Delhi for over two decades and is recognised as one of India's most trusted ear surgeons."}],["$","p",null,{"className":"text-teal-50 leading-relaxed mb-4","children":"Patients choose Dr.(Prof.) Dhirendra Singh kushwah for ear and hearing treatment because of his precision surgical technique, transparent communication, and genuine commitment to every patient's recovery — whether they are a newborn undergoing hearing screening or an adult seeking cochlear implantation after years of profound hearing loss."}],["$","p",null,{"className":"text-teal-50 leading-relaxed","children":"He is available in English and Hindi, personally reachable at all hours, and operates from two conveniently located clinics in New Delhi."}],["$","div",null,{"className":"mt-6 flex gap-3 flex-wrap","children":[["$","div",null,{"className":"bg-white/10 px-4 py-2 rounded-full text-sm","children":"Over 700 cochlear implants"}],["$","div",null,{"className":"bg-white/10 px-4 py-2 rounded-full text-sm","children":"25+ years experience"}]]}]]}]]}]}]
9:["$","$L21",null,{"faqItems":[{"q":"What is the difference between an ENT doctor and an otologist?","a":"An ENT (Ear, Nose and Throat) specialist treats all three areas of the head and neck. An otologist is an ENT who has undergone additional specialised training exclusively in ear diseases, hearing, and balance — including microsurgery and cochlear implantation. Dr.(Prof.) Dhirendra Singh kushwah practises as both a senior ENT and an experienced otologist."},{"q":"Can hearing loss be cured?","a":"Conductive hearing loss — caused by eardrum perforation, fluid, or ossicular damage — is often curable with surgery. Sensorineural hearing loss caused by cochlear damage is generally not reversible, but can be highly effectively managed with hearing aids or cochlear implants, restoring functional hearing."},{"q":"Is tympanoplasty a major surgery?","a":"Tympanoplasty is performed under general or local anaesthesia and typically takes one to two hours. It is not considered a major surgery, but it is microsurgical — requiring great precision. Most patients are discharged the same day or after one night's observation, with full recovery in four to six weeks."},{"q":"At what age can a child receive a cochlear implant?","a":"Cochlear implants can be placed in children as young as 12 months of age — and earlier in cases of bilateral profound hearing loss where medical urgency is established. The earlier the implant, the better the child's prospects for natural speech and language development."},{"q":"Is stapedotomy safe? What are the risks?","a":"Stapedotomy is a highly refined procedure with excellent outcomes in experienced hands. In a small number of cases there is a risk of inner ear damage leading to sensorineural hearing loss - which is why it should only be performed by a specialist with significant experience. Dr.(Prof.) Dhirendra Singh kushwah has performed this procedure extensively with high success rates."},{"q":"What causes sudden hearing loss in one ear?","a":"Sudden sensorineural hearing loss (SSNHL) can result from viral infection, vascular disruption to the cochlea, autoimmune conditions, or perilymph fistula. In many cases the exact cause is not found. It is a medical emergency — seek evaluation within 24-48 hours for the best chance of recovery."},{"q":"How do I know if my child has a hearing problem?","a":"Signs in infants include not reacting to loud sounds, not turning toward voices, and not babbling by 6 months. In older children, watch for not responding when called, asking for things to be repeated, turning the TV up too loud, or falling behind in speech. Bring your child for a hearing evaluation without delay if you notice any of these signs."}]}]
