3:T42f,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is sinusitis and what causes it?","acceptedAnswer":{"@type":"Answer","text":"Sinusitis is inflammation of the sinuses, often caused by viral infections, allergies, nasal polyps, or a deviated nasal septum. It can be acute (less than 4 weeks) or chronic (more than 12 weeks)."}},{"@type":"Question","name":"Can sinusitis be cured without surgery?","acceptedAnswer":{"@type":"Answer","text":"Yes, most cases of acute sinusitis resolve with medication — decongestants, nasal saline rinses, antibiotics (if bacterial), and antihistamines for allergy-related cases. Surgery is recommended only for chronic or recurrent sinusitis that does not respond to medical management."}},{"@type":"Question","name":"How long does sinus treatment take to show results?","acceptedAnswer":{"@type":"Answer","text":"Acute sinusitis typically improves within 7–14 days with proper medication. Chronic sinusitis may require 4–8 weeks of medical treatment before surgery is considered."}}]}0:{"buildId":"build-1789436362807","rsc":["$","$1","c",{"children":[[[["$","$L2","0",{"id":"schema-0","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"MedicalClinic\",\"name\":\"Dr. Dhirendra Singh Kushwah – CR Park ENT Clinic\",\"url\":\"undefined/clinics/cr-park/\",\"telephone\":\"+919311449825\",\"email\":\"drdhirendrasinghent@gmail.com\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"CR Park\",\"addressRegion\":\"South Delhi\",\"addressCountry\":\"IN\"},\"medicalSpecialty\":\"Otolaryngology\",\"physician\":{\"@type\":\"Physician\",\"name\":\"Dr. Dhirendra Singh Kushwah\",\"medicalSpecialty\":\"Otolaryngology\"}}"}}],["$","$L2","1",{"id":"schema-1","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"MedicalCondition\",\"name\":\"Sinusitis\",\"code\":{\"@type\":\"Medical