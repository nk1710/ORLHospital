2:T1389,{"@context":"https://schema.org","@graph":[{"@type":"MedicalWebPage","@id":"https://www.drdhirendrasinghkushwah.in/specialities/tympanoplasty-surgery#webpage","url":"https://www.drdhirendrasinghkushwah.in/specialities/tympanoplasty-surgery","name":"Best Tympanoplasty Surgeon in Delhi | Eardrum Repair Specialist - Dr. Dhirendra Singh Kushwah","description":"Information about tympanoplasty surgery, eardrum perforation, symptoms, diagnosis, treatment, recovery and when to consult an ENT surgeon.","medicalAudience":{"@type":"MedicalAudience","audienceType":"Patient"},"about":{"@id":"https://www.drdhirendrasinghkushwah.in/specialities/tympanoplasty-surgery#tympanoplasty"}},{"@type":"SurgicalProcedure","@id":"https://www.drdhirendrasinghkushwah.in/specialities/tympanoplasty-surgery#tympanoplasty","name":"Tympanoplasty Surgery","alternateName":["Eardrum Repair Surgery","Tympanic Membrane Repair"],"description":"Tympanoplasty is a surgical procedure used to repair a perforated or damaged eardrum and, when appropriate, improve hearing and protect the middle ear.","bodyLocation":"Tympanic membrane (eardrum)","procedureType":"Surgical","preparation":"Evaluation may include ear examination, hearing assessment and other tests depending on the cause and severity of the ear problem.","followup":"Follow-up examinations are performed to monitor healing of the graft and ear. Hearing improvement may occur gradually during recovery.","indication":["Persistent perforated eardrum","Chronic ear discharge","Hearing loss associated with eardrum damage","Recurrent middle ear infections","Eardrum damage following trauma"],"benefit":["Repair of the eardrum","Protection of the middle ear","Reduction of recurrent ear discharge in appropriate cases","Potential improvement in hearing","Reduction in the risk of water entering the middle ear through a perforation"],"riskFactor":["Infection","Bleeding","Temporary discomfort","Incomplete healing","Persistent or recurrent hearing problems","Graft failure in some cases"],"provider":{"@id":"https://www.drdhirendrasinghkushwah.in/#physician"},"availableAtOrFrom":{"@type":"MedicalClinic","name":"ENT Clinic - Arjun Nagar","address":{"@type":"PostalAddress","streetAddress":"19-C, Arjun Nagar Safdarjung Enclave","addressLocality":"New Delhi","postalCode":"110029","addressCountry":"IN"},"telephone":"+91-9311449825"}},{"@type":"VideoObject","name":"Tympanoplasty Surgery Explained","description":"Educational video explaining tympanoplasty surgery, eardrum repair and recovery.","thumbnailUrl":"https://img.youtube.com/vi/GNeHj38ahPs/hqdefault.jpg","uploadDate":"2024-01-01","embedUrl":"https://www.youtube.com/embed/GNeHj38ahPs"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is tympanoplasty surgery?","acceptedAnswer":{"@type":"Answer","text":"Tympanoplasty is an operation used to repair a perforated or damaged eardrum. Depending on the condition of the ear, the procedure may also help improve hearing and protect the middle ear from repeated infection."}},{"@type":"Question","name":"What are the symptoms of a perforated eardrum?","acceptedAnswer":{"@type":"Answer","text":"Common symptoms may include hearing loss, ear discharge, ear pain, ringing in the ear, recurrent ear infections and sometimes dizziness. Some people may have very few symptoms despite having an eardrum perforation."}},{"@type":"Question","name":"Who may need tympanoplasty?","acceptedAnswer":{"@type":"Answer","text":"Tympanoplasty may be considered for patients with a persistent eardrum perforation, recurrent ear infections, chronic ear discharge, or hearing problems associated with damage to the eardrum. The need for surgery depends on the individual ear condition."}},{"@type":"Question","name":"How is tympanoplasty diagnosed?","acceptedAnswer":{"@type":"Answer","text":"An ENT specialist may examine the ear using an otoscope or microscope and may recommend hearing tests such as pure tone audiometry. Additional investigations may be advised when clinically necessary."}},{"@type":"Question","name":"How long does tympanoplasty recovery take?","acceptedAnswer":{"@type":"Answer","text":"Initial healing generally takes several weeks, while complete healing and hearing improvement can take longer depending on the type of surgery, the condition of the ear and individual recovery."}},{"@type":"Question","name":"Is tympanoplasty painful?","acceptedAnswer":{"@type":"Answer","text":"Tympanoplasty is performed under appropriate anaesthesia. Some patients may experience temporary discomfort, fullness or mild pain during recovery, which is managed according to the surgeon's instructions."}},{"@type":"Question","name":"When should I see an ENT doctor for a perforated eardrum?","acceptedAnswer":{"@type":"Answer","text":"You should consult an ENT doctor if you have persistent ear discharge, hearing loss, recurrent ear infections, an ear injury, a known eardrum perforation, severe ear pain, dizziness or symptoms that do not improve."}}]}]}0:{"buildId":"build-1789436362807","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3"],null,"$L4"]}],"loading":null,"isPartial":false}
3:["$","main",null,{"className":"max-w-6xl mx-auto px-4 py-8 space-y-12","children":[["$","section",null,{"children":[["$","p",null,{"className":"text-sm text-gray-500 mb-2","children":"Tympanoplasty Surgeon in Delhi, India"}],["$","h1",null,{"className":"text-3xl md:text-4xl font-bold mt-2 leading-tight","children":"Best Tympanoplasty Surgeon in Delhi | Eardrum Repair Specialist – Dr. Dhirendra Singh Kushwah"}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-5","children":"Dr. Dhirendra Singh Kushwah is an experienced ENT surgeon in Delhi providing evaluation and surgical treatment for eardrum perforation, chronic ear discharge, recurrent ear infections and hearing problems. Tympanoplasty, also known as eardrum repair surgery, is performed when a damaged or perforated eardrum does not heal adequately or requires surgical reconstruction."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-4","children":["If you are searching for a"," ",["$","strong",null,{"children":"Tympanoplasty Surgeon in Delhi"}],","," ",["$","strong",null,{"children":"eardrum repair specialist in Delhi"}],", or"," ",["$","strong",null,{"children":"perforated eardrum treatment"}],", an ENT evaluation can help determine whether observation, medication, hearing rehabilitation or surgery is appropriate for your condition."]}]]}],["$","section",null,{"className":"bg-gray-50 rounded-2xl p-6 md:p-8 border","children":[["$","h2",null,{"className":"text-2xl font-bold mb-4","children":"What Is Tympanoplasty?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":[["$","strong",null,{"children":"Tympanoplasty is surgery to repair a perforated or damaged eardrum."}]," The procedure may be recommended when an eardrum hole persists, causes recurrent ear discharge or contributes to hearing problems. During surgery, the ENT surgeon repairs the damaged tympanic membrane, often using a graft material, with the aim of restoring the structure of the eardrum and protecting the middle ear."]}]]}],["$","section",null,{"children":[["$","div",null,{"className":"rounded-xl overflow-hidden shadow","children":["$","iframe",null,{"className":"w-full h-[300px] md:h-[450px]","src":"https://www.youtube.com/embed/GNeHj38ahPs?si=Wg0MefNIa2US7_Ru","title":"Tympanoplasty Surgery Explained","loading":"lazy","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share","allowFullScreen":true}]}],["$","p",null,{"className":"text-gray-600 mt-4 font-semibold","children":["$","a",null,{"href":"https://www.youtube.com/@dr.dhirendrasingh","target":"_blank","rel":"noopener noreferrer","className":"text-blue-600 underline","children":"Watch more ENT health videos from Dr. Dhirendra Singh Kushwah"}]}]]}],["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Symptoms of a Perforated or Damaged Eardrum"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"A perforated eardrum may occur because of an ear infection, trauma, sudden pressure changes, foreign objects or other ear problems. Symptoms vary depending on the size and location of the perforation and whether the middle ear is also affected."}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Reduced or muffled hearing"}],["$","li",null,{"children":"Ear discharge or fluid coming from the ear"}],["$","li",null,{"children":"Repeated ear infections"}],["$","li",null,{"children":"Ear pain or discomfort"}],["$","li",null,{"children":"Ringing or buzzing sound in the ear (tinnitus)"}],["$","li",null,{"children":"A feeling of fullness or pressure in the ear"}],["$","li",null,{"children":"Sudden hearing changes following an injury"}],["$","li",null,{"children":"Dizziness or imbalance in some cases"}],"$L5"]}],"$L6"]}],"$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14"]}]
