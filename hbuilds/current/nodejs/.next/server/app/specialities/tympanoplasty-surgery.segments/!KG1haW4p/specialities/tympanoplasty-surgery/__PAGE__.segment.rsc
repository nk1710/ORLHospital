7:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"What Causes Eardrum Perforation?"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"The eardrum is a thin membrane separating the ear canal from the middle ear. It can develop a hole or tear for several reasons."}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Chronic or recurrent middle ear infections"}],["$","li",null,{"children":"Ear trauma or injury"}],["$","li",null,{"children":"Sudden changes in air pressure"}],["$","li",null,{"children":"Insertion of objects or cotton buds into the ear"}],["$","li",null,{"children":"Severe infection causing pressure on the eardrum"}],["$","li",null,{"children":"Previous ear surgery"}],["$","li",null,{"children":"Long-standing middle ear disease"}]]}]]}]
8:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Who May Need Tympanoplasty Surgery?"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Tympanoplasty is not automatically required for every eardrum perforation. Some small perforations may heal naturally. Surgery may be considered when the perforation persists or when it is associated with recurrent infections, discharge or hearing problems."}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Persistent perforated eardrum"}],["$","li",null,{"children":"Chronic ear discharge"}],["$","li",null,{"children":"Recurrent middle ear infections"}],["$","li",null,{"children":"Hearing loss associated with eardrum damage"}],["$","li",null,{"children":"Eardrum damage following trauma"}],["$","li",null,{"children":"Persistent ear problems despite appropriate treatment"}],["$","li",null,{"children":"Selected cases requiring reconstruction of the eardrum"}]]}]]}]
