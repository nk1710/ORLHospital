c:["$","$L18",null,{"faqItems":[{"type":"header","text":"Patient Testimonials & Case Success"},{"q":"Who is Dr.(Prof.) Dhirendra Singh Kushwah?","a":"Dr. Dhirendra Singh Kushwah is a highly experienced Otorhinolaryngologist (ENT Specialist) with over 25 years of practice. He is the Head of the ENT Department at ORL International Group of Hospitals and a Senior Consultant at Saket City Hospital. He is globally trained in Austria and Australia, specializing in advanced sinus, skull base, and ear surgeries."},{"q":"Where is Dr.(Prof.) Dhirendra Singh Kushwah’s clinic located?","a":"Dr.(Prof.) Dhirendra Singh Kushwah sees patients at multiple convenient locations in Delhi and NCR: Jasola: ORL International Group of Hospitals, Plot No. 89, Pocket 1. CR Park: J-1981, Bipin Chandra Pal Marg (Near Market No. 1). Arjun Nagar: ENT & Gynae Clinic, 19-C, Safdarjung Enclave. Other Locations: He also consults in Palwal and Dhampur."},{"q":"What services does Dr.(Prof.) Dhirendra Singh Kushwah provide?","a":"He provides comprehensive diagnostic and surgical care for all ear, nose, and throat conditions. Key services include Cochlear Implants, Sinus & Allergy management, Skull Base Surgery, Hearing Loss evaluations, Snoring & Sleep Apnea treatment, and Pediatric ENT care."},{"type":"header","text":"Appointments & Logistics"},{"q":"How can I schedule an appointment with Dr.(Prof.) Dhirendra Singh Kushwah?","a":"You can book an appointment by calling our central helpline at +91-9311449825 or by using the online booking system on our official website. Walk-in appointments may be available, but scheduling in advance is recommended to minimize wait times."},{"q":"Does Dr. Dhirendra Singh Kushwah offer telemedicine consultations?","a":"Yes, we offer virtual video consultations for patients who cannot visit the clinic in person. To schedule a virtual visit, please contact our office or select the 'Telemedicine' option on our website."},{"q":"What should I bring to my first appointment?","a":"Please bring your government ID, previous medical records (CT scans, MRIs, or discharge summaries), a list of current medications, and your insurance card if applicable."},{"q":"What are the office hours?","a":"Dr.(Prof.) Dhirendra Singh Kushwah’s services are generally available between 9:00 AM and 9:00 PM, 7 days a week, though timings vary by location. (e.g., Jasola: 9:30 AM – 3:30 PM; CR Park: 6:30 PM – 9:00 PM)."},{"type":"header","text":"Surgical & Post-Care FAQ"},{"q":"Does Dr.(Prof.) Dhirendra Singh Kushwah perform surgeries?","a":"Yes. Dr. Kushwah is a surgical expert specializing in minimally invasive procedures, including 'scarless' Functional Endoscopic Sinus Surgery (FESS), Micro-ear surgery, and Sleep Apnea corrective surgery."},{"q":"What should I expect after my treatment or surgery?","a":"Recovery varies by procedure. Dr.(Prof.) Dhirendra Singh Kushwah provides a detailed post-operative plan, including medication schedules, physical activity restrictions, and scheduled follow-up visits to monitor your healing."},{"type":"header","text":"Payments & Insurance"},{"q":"Does Dr.(Prof.) Dhirendra Singh Kushwah accept insurance?","a":"Yes, we accept a wide variety of insurance plans and TPA providers. Because coverage varies, we recommend contacting our billing department at 011-35667722 to verify your specific plan before your visit."},{"q":"What payment methods are accepted?","a":"For your convenience, we accept Cash, Credit/Debit cards, UPI (GPay/PhonePe), and direct insurance billing for covered procedures."}]}]
