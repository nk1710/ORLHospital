3e:["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"Recovery varies between patients. Throat pain, painful swallowing, tiredness and changes in eating or drinking can occur during the early recovery period. The ENT surgeon provides individualized instructions regarding hydration, diet, medicines and activity."}]
3f:["$","details","Can tonsillectomy help with snoring?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[6,"."]}],"Can tonsillectomy help with snoring?"]}],["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"Tonsillectomy may help selected patients whose snoring or sleep-related breathing problems are significantly related to enlarged tonsils. Because snoring can have multiple causes, an ENT assessment is important before deciding on surgery."}]]}]
40:["$","details","Can tonsils grow back after tonsillectomy?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[7,"."]}],"Can tonsils grow back after tonsillectomy?"]}],["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"After complete removal of the tonsils, significant regrowth is uncommon. If only part of the tonsil tissue is removed during a particular surgical technique, some tissue remains and may potentially enlarge again."}]]}]
41:["$","details","Is tonsillectomy painful?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[8,"."]}],"Is tonsillectomy painful?"]}],["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"Throat pain is common after tonsillectomy, particularly while swallowing. Pain varies between patients and changes during recovery. The treating surgeon provides appropriate pain-control, hydration and dietary instructions."}]]}]
42:["$","details","What happens if recurrent tonsillitis is not treated?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[9,"."]}],"What happens if recurrent tonsillitis is not treated?"]}],["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"Some patients may continue to experience repeated throat infections, difficulty swallowing, disturbed sleep, missed school or work and reduced quality of life. Certain infections can also develop complications, so recurrent or severe symptoms should be assessed by an ENT specialist."}]]}]
43:["$","details","Which doctor performs tonsillectomy in Delhi?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[10,"."]}],"Which doctor performs tonsillectomy in Delhi?"]}],["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"Tonsillectomy is performed by an ENT specialist or otolaryngology surgeon. Dr. Dhirendra Singh Kushwah provides ENT evaluation and surgical care for tonsil-related conditions in Delhi."}]]}]
