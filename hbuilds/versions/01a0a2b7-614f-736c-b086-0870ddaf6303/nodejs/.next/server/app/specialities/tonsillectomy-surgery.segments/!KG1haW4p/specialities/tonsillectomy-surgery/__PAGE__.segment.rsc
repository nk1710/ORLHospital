5:["$","section",null,{"className":"px-4 py-14 md:py-20","children":["$","div",null,{"className":"mx-auto max-w-6xl","children":["$","div",null,{"className":"grid gap-10 lg:grid-cols-[1fr_0.8fr]","children":[["$","div",null,{"children":[["$","p",null,{"className":"font-semibold uppercase tracking-wider text-teal-700","children":"Tonsil Removal Surgery in Delhi"}],["$","h2",null,{"className":"mt-2 text-3xl font-bold text-slate-900 md:text-4xl","children":"Evaluation and Treatment for Recurrent Tonsil Problems"}],["$","div",null,{"className":"mt-6 space-y-5 text-lg leading-8 text-slate-600","children":[["$","p",null,{"children":"Tonsils are collections of lymphoid tissue located at the back of the throat. They are part of the immune system, but they can themselves become repeatedly infected or significantly enlarged."}],["$","p",null,{"children":"Recurrent tonsillitis can cause repeated sore throat, fever, painful swallowing, swollen neck glands and time away from school or work. Enlarged tonsils may also contribute to snoring, mouth breathing and sleep-related breathing difficulties."}],["$","p",null,{"children":"Dr. Dhirendra Singh Kushwah provides ENT assessment for patients with recurrent tonsil infections and other tonsil-related conditions in Delhi. Tonsillectomy is considered when the expected clinical benefits outweigh the potential risks of surgery."}]]}]]}],["$","div",null,{"className":"rounded-3xl bg-slate-900 p-7 text-white shadow-xl md:p-9","children":[["$","h3",null,{"className":"text-2xl font-bold","children":"Common Reasons for Tonsillectomy"}],["$","div",null,{"className":"mt-6 space-y-4","children":[["$","div","Recurrent tonsillitis",{"className":"flex items-start gap-3 border-b border-white/10 pb-3 last:border-0","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide