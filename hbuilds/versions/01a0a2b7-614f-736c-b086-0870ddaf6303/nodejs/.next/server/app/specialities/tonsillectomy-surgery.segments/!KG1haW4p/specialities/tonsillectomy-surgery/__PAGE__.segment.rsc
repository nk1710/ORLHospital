14:["$","section",null,{"id":"tonsillectomy-faq","className":"px-4 py-14 md:py-20","children":["$","div",null,{"className":"mx-auto max-w-5xl","children":[["$","div",null,{"className":"text-center","children":[["$","p",null,{"className":"font-semibold uppercase tracking-wider text-teal-700","children":"Frequently Asked Questions"}],["$","h2",null,{"className":"mt-2 text-3xl font-bold text-slate-900 md:text-4xl","children":"Tonsillectomy FAQs"}]]}],["$","div",null,{"className":"mt-10 space-y-4","children":[["$","details","What is tonsillectomy?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[1,"."]}],"What is tonsillectomy?"]}],["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"Tonsillectomy is a surgical procedure to remove the tonsils. It may be recommended for selected patients with recurrent or severe tonsillitis, chronically enlarged tonsils, repeated tonsil-related complications, or breathing and swallowing problems associated with enlarged tonsils."}]]}],["$","details","Who may need tonsil removal surgery?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[2,"."]}],"Who may need tonsil removal surgery?"]}],["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"Tonsillectomy may be considered for patients with recurrent or severe tonsillitis, chronically infected tonsils, significantly enlarged tonsils causing swallowing or breathing problems, selected sleep-related breathing problems, recurrent peritonsillar abscess, or other tonsil-related complications."}]]}],["$","details","What are the symptoms of enlarged or infected tonsils?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[3,"."]}],"What are the symptoms of enlarged or infected tonsils?"]}],["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"Symptoms may include recurrent sore throat, painful swallowing, fever during infections, red or swollen tonsils, white patches or pus, swollen neck glands, bad breath, tonsil stones, snoring, mouth breathing and sleep-related breathing difficulties."}]]}],["$","details","How long does tonsillectomy surgery take?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[4,"."]}],"How long does tonsillectomy surgery take?"]}],["$","p",null,{"className":"mt-4 border-t border-slate-100 pt-4 leading-7 text-slate-600","children":"The surgical procedure is generally completed within a relatively short operative period, but the exact duration depends on the patient's age, anatomy, medical condition, surgical findings and hospital and anaesthesia protocols."}]]}],["$","details","How long does recovery take after tonsillectomy?",{"className":"group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-slate-900","children":[["$","span",null,{"className":"mr-3 text-teal-700","children":[5,"."]}],"How long does recovery take after tonsillectomy?"]}],"$L3e"]}],"$L3f","$L40","$L41","$L42","$L43"]}]]}]}]
