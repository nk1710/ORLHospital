d:["$","section",null,{"className":"bg-slate-950 py-20 text-white lg:py-24","children":["$","div",null,{"className":"mx-auto max-w-7xl px-6 lg:px-8","children":["$","div",null,{"className":"grid gap-12 lg:grid-cols-2 lg:items-center","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-bold uppercase tracking-widest text-teal-300","children":"ENT Care in Delhi"}],["$","h2",null,{"className":"mt-3 text-3xl font-bold sm:text-4xl","children":"Why Choose Dr. Dhirendra Singh Kushwah for Allergy & ENT Care?"}],["$","p",null,{"className":"mt-5 text-lg leading-8 text-slate-300","children":"Persistent allergy symptoms can sometimes overlap with sinus disease, nasal structural problems, enlarged turbinates or other ENT conditions. A comprehensive ENT evaluation can help identify the underlying cause and guide appropriate treatment."}],["$","div",null,{"className":"mt-8 space-y-5","children":[["$","div",null,{"className":"flex gap-4","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-award mt-1 h-6 w-6 shrink-0 text-teal-300","aria-hidden":"true","children":[["$","path","1yiouv",{"d":"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"}],["$","circle","1vp47v",{"cx":"12","cy":"8","r":"6"}],"$undefined"]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-bold","children":"25+ Years of ENT Experience"}],["$","p",null,{"className":"mt-1 text-slate-400","children":"Extensive experience in ENT, sinus, nasal and head & neck conditions."}]]}]]}],["$","div",null,{"className":"flex gap-4","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin"