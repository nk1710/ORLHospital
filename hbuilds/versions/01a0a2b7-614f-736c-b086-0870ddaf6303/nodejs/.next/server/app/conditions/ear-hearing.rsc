2c:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-gray-50","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-4 text-center","children":" Hearing Tests and Audiological Evaluation"}],["$","p",null,{"className":"text-gray-600 text-center max-w-2xl mx-auto mb-10","children":"Before any treatment is recommended, every patient undergoes a structured hearing assessment. The following tests are available at the clinic:"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto","children":[["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Pure Tone Audiogram (PTA)"}]," identifies the degree and type of hearing loss across all frequencies."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Speech Audiogram"}]," measures how clearly a person can hear and understand spoken words — reflecting real-world functional hearing ability."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Tympanometry"}]," checks the mobility of the eardrum and detects middle ear fluid, Eustachian tube dysfunction, or ossicular problems."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Auditory Brainstem Response (ABR)"}]," records the brain's electrical response to sound — used for infants, newborns, and uncooperative patients who cannot complete standard tests."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Auditory Steady-State Response (ASSR)"}]," provides frequency-specific thresholds essential for planning cochlear implant candidacy in young children."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Otoacoustic Emissions (OAE)"}]," tests outer hair cell function in the cochlea — a quick, objective, and non-invasive screening tool."]}]}],["$","div",null,{"className":"bg-white p-5 rounded-xl shadow-sm","children":["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"Newborn Hearing Screening"}]," — OAE and ABR-based screening to detect hearing loss at birth and trigger early intervention before the critical language development window closes."]}]}]]}]]}]}]
2d:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center","children":[["$","div",null,{"className":"relative","children":[["$","div",null,{"className":"absolute -inset-4 bg-teal-500/10 rounded-[40px] rotate-3 z-0"}],["$","div",null,{"className":"relative z-10 rounded-2xl overflow-hidden border border-gray-200 shadow-sm aspect-video bg-gray-100 flex items-center justify-center","children":[["$","span",null,{"className":"absolute text-gray-400 text-sm font-medium","children":"ENT Conditions & Specialized Treatment"}],["$","iframe",null,{"className":"relative w-full h-full z-10","src":"https://www.youtube.com/embed/aC8UxzOKVw4","title":"Dr.(Prof.) Dhirendra Singh Kushwah – ENT Conditions & Specialized Treatment","frameBorder":"0","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share","referrerPolicy":"strict-origin-when-cross-origin","allowFullScreen":true}]]}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-900 mb-6","children":" Why Patients Choose Dr. Dhirendra Singh kushwah for Ear Treatment"}],["$","div",null,{"className":"space-y-4 text-gray-700","children":[["$","p",null,{"children":"Dr.(Prof.) Dhirendra Singh kushwah completed his MBBS from Jiwaji University, Gwalior (1999) and his MS in ENT from Rani Durgawati University, Jabalpur (2005). He has been practising and operating in New Delhi for over two decades and is recognised as one of India's most trusted ear surgeons."}],["$","p",null,{"children":"Patients choose Dr.(Prof.) Dhirendra Singh kushwah for ear and hearing treatment because of his precision surgical technique, transparent communication, and genuine commitment to every patient's recovery — whether they are a newborn undergoing hearing screening or an adult seeking cochlear implantation after years of profound hearing loss."}],["$","p",null,{"children":"He is available in English and Hindi, personally reachable at all hours, and operates from two conveniently located clinics in New Delhi."}],["$","p",null,{"className":"font-medium","children":["$","strong",null,{"children":"Over 700 cochlear and auditory brainstem implant recipients under his care — one of the highest programme volumes in India."}]}]]}]]}]]}]}]}]
2e:["$","$L41",null,{"faqItems":[{"q":"What is the difference between an ENT doctor and an otologist?","a":"An ENT (Ear, Nose and Throat) specialist treats all three areas of the head and neck. An otologist is an ENT who has undergone additional specialised training exclusively in ear diseases, hearing, and balance — including microsurgery and cochlear implantation. Dr.(Prof.) Dhirendra Singh kushwah practises as both a senior ENT and an experienced otologist."},{"q":"Can hearing loss be cured?","a":"Conductive hearing loss — caused by eardrum perforation, fluid, or ossicular damage — is often curable with surgery. Sensorineural hearing loss caused by cochlear damage is generally not reversible, but can be highly effectively managed with hearing aids or cochlear implants, restoring functional hearing."},{"q":"Is tympanoplasty a major surgery?","a":"Tympanoplasty is performed under general or local anaesthesia and typically takes one to two hours. It is not considered a major surgery, but it is microsurgical — requiring great precision. Most patients are discharged the same day or after one night's observation, with full recovery in four to six weeks."},{"q":"At what age can a child receive a cochlear implant?","a":"Cochlear implants can be placed in children as young as 12 months of age — and earlier in cases of bilateral profound hearing loss where medical urgency is established. The earlier the implant, the better the child's prospects for natural speech and language development."},{"q":"Is stapedotomy safe? What are the risks?","a":"Stapedotomy is a highly refined procedure with excellent outcomes in experienced hands. In a small number of cases there is a risk of inner ear damage leading to sensorineural hearing loss - which is why it should only be performed by a specialist with significant experience. Dr.(Prof.) Dhirendra Singh kushwah has performed this procedure extensively with high success rates."},{"q":"What causes sudden hearing loss in one ear?","a":"Sudden sensorineural hearing loss (SSNHL) can result from viral infection, vascular disruption to the cochlea, autoimmune conditions, or perilymph fistula. In many cases the exact cause is not found. It is a medical emergency — seek evaluation within 24-48 hours for the best chance of recovery."},{"q":"How do I know if my child has a hearing problem?","a":"Signs in infants include not reacting to loud sounds, not turning toward voices, and not babbling by 6 months. In older children, watch for not responding when called, asking for things to be repeated, turning the TV up too loud, or falling behind in speech. Bring your child for a hearing evaluation without delay if you notice any of these signs."}]}]
2f:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-4xl mx-auto bg-teal-600 rounded-[40px] p-8 md:p-12 text-center shadow-2xl","children":[["$","h2",null,{"className":"text-3xl md:text-4xl font-bold text-white mb-4","children":" Book an Appointment with Dr.(Prof.) Dhirendra Singh kushwah"}],["$","p",null,{"className":"text-teal-100 text-lg mb-6","children":"If you are experiencing any ear or hearing concern - however mild it may seem - early expert assessment leads to better outcomes. Dr.(Prof.) Dhirendra Singh kushwah and his team are available six days a week at two New Delhi locations."}],["$","div",null,{"className":"space-y-2 text-white","children":[["$","p",null,{"className":"text-xl font-semibold","children":"Call or WhatsApp: +91-9311449825"}],["$","p",null,{"children":"Email: drdhirendrasinghent@gmail.com"}],["$","div",null,{"className":"mt-6 pt-4 border-t border-teal-400/30","children":[["$","p",null,{"children":[["$","strong",null,{"children":"CR Park Clinic:"}]," J-1981, Near Market No. 1, Below ICICI Bank, Bipin Chandra Pal Marg, CR Park, New Delhi – 110019"]}],["$","p",null,{"className":"mt-2","children":[["$","strong",null,{"children":"Arjun Nagar Clinic:"}]," 19-C, Arjun Nagar, Safdarjung Enclave, New Delhi – 110029"]}]]}]]}]]}]}]
