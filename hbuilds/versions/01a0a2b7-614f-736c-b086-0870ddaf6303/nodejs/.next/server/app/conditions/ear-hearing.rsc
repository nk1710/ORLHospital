26:T1333,{"@context":"https://schema.org","@graph":[{"@type":"MedicalCondition","name":"Ear & Hearing Conditions","description":"A comprehensive overview of ear and hearing conditions including infections, hearing loss, tinnitus, and balance disorders.","url":"https://www.drdhirendrasinghkushwah.in/conditions/ear-hearing","associatedAnatomy":{"@type":"AnatomicalStructure","name":"Ear","url":"https://en.wikipedia.org/wiki/Ear"},"possibleComplication":[{"@type":"MedicalCondition","name":"Hearing Loss"},{"@type":"MedicalCondition","name":"Tinnitus"},{"@type":"MedicalCondition","name":"Vertigo"}]},{"@type":"Physician","name":"Dr.(Prof.) Dhirendra Singh kushwah","url":"https://www.drdhirendrasinghkushwah.in/","image":"https://www.drdhirendrasinghkushwah.in/images/dherendra_patient.png","description":"Senior ENT and Otology Specialist in New Delhi with over 25 years of experience","medicalSpecialty":"Otology","qualifications":[{"@type":"EducationalOccupationalCredential","name":"MBBS","educationalLevel":"Bachelor's degree","issuingOrganization":{"@type":"EducationalOrganization","name":"Jiwaji University, Gwalior","year":1999}},{"@type":"EducationalOccupationalCredential","name":"MS in ENT","educationalLevel":"Master's degree","issuingOrganization":{"@type":"EducationalOrganization","name":"Rani Durgawati University, Jabalpur","year":2005}}],"areaServed":{"@type":"Place","name":"New Delhi, India"},"contactPoint":[{"@type":"ContactPoint","telephone":"+91-9311449825","contactType":"Customer Service","areaServed":"IN","availableLanguage":["en","hi"]}],"knowsAbout":["Cochlear Implants","Tympanoplasty","Mastoidectomy","Ossiculoplasty","Stapedotomy","Otosclerosis","Menière's Disease"]},{"@type":"FAQPage","url":"https://www.drdhirendrasinghkushwah.in/conditions/ear-hearing","mainEntity":[{"@type":"Question","name":"What is the difference between an ENT doctor and an otologist?","acceptedAnswer":{"@type":"Answer","text":"An ENT (Ear, Nose and Throat) specialist treats all three areas of the head and neck. An otologist is an ENT who has undergone additional specialised training exclusively in ear diseases, hearing, and balance — including microsurgery and cochlear implantation. Dr.(Prof.) Dhirendra Singh kushwah practises as both a senior ENT and an experienced otologist."}},{"@type":"Question","name":"Can hearing loss be cured?","acceptedAnswer":{"@type":"Answer","text":"Conductive hearing loss — caused by eardrum perforation, fluid, or ossicular damage — is often curable with surgery. Sensorineural hearing loss caused by cochlear damage is generally not reversible, but can be highly effectively managed with hearing aids or cochlear implants, restoring functional hearing."}},{"@type":"Question","name":"Is tympanoplasty a major surgery?","acceptedAnswer":{"@type":"Answer","text":"Tympanoplasty is performed under general or local anaesthesia and typically takes one to two hours. It is not considered a major surgery, but it is microsurgical — requiring great precision. Most patients are discharged the same day or after one night's observation, with full recovery in four to six weeks."}},{"@type":"Question","name":"At what age can a child receive a cochlear implant?","acceptedAnswer":{"@type":"Answer","text":"Cochlear implants can be placed in children as young as 12 months of age — and earlier in cases of bilateral profound hearing loss where medical urgency is established. The earlier the implant, the better the child's prospects for natural speech and language development."}},{"@type":"Question","name":"Is stapedotomy safe? What are the risks?","acceptedAnswer":{"@type":"Answer","text":"Stapedotomy is a highly refined procedure with excellent outcomes in experienced hands. In a small number of cases there is a risk of inner ear damage leading to sensorineural hearing loss - which is why it should only be performed by a specialist with significant experience. Dr.(Prof.) Dhirendra Singh kushwah has performed this procedure extensively with high success rates."}},{"@type":"Question","name":"What causes sudden hearing loss in one ear?","acceptedAnswer":{"@type":"Answer","text":"Sudden sensorineural hearing loss (SSNHL) can result from viral infection, vascular disruption to the cochlea, autoimmune conditions, or perilymph fistula. In many cases the exact cause is not found. It is a medical emergency — seek evaluation within 24-48 hours for the best chance of recovery."}},{"@type":"Question","name":"How do I know if my child has a hearing problem?","acceptedAnswer":{"@type":"Answer","text":"Signs in infants include not reacting to loud sounds, not turning toward voices, and not babbling by 6 months. In older children, watch for not responding when called, asking for things to be repeated, turning the TV up too loud, or falling behind in speech. Bring your child for a hearing evaluation without delay if you notice any of these signs."}}]}]}19:["$","div",null,{"className":"bg-white","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$26"}}],"$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}]
