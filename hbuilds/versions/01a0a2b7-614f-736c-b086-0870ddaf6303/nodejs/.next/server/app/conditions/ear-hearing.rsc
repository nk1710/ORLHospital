28:["$","section",null,{"className":"py-16 px-4 md:px-8 bg-gray-50","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-12 items-center","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-800","children":" What Is Otology? Understanding the Science of Ear Health"}],["$","div",null,{"className":"w-16 h-1 bg-teal-600 rounded"}],["$","p",null,{"className":"text-gray-600 text-lg leading-relaxed","children":"Otology is the branch of medicine dedicated to the anatomy, function, and diseases of the ear. An otologist — also called an ear specialist or otology surgeon — is trained to manage conditions affecting the outer ear, middle ear, inner ear, hearing nerve, and the balance system."}],["$","p",null,{"className":"text-gray-600 text-lg leading-relaxed","children":"Unlike a general ENT doctor, an otology specialist has advanced training in microsurgery of the ear, cochlear implantation, and neuro-otology. This depth of expertise is essential when dealing with conditions that affect hearing, balance, and quality of life at a fundamental level."}]]}],["$","div",null,{"className":"bg-teal-50 border-l-4 border-teal-600 p-6 rounded-r-xl","children":["$","p",null,{"className":"text-teal-900 font-medium italic","children":"\"Precision is paramount in ear surgery. The structures we work with are measured in millimeters, and the impact on a patient's life is measured in years of better hearing.\""}]}]]}]}]}]
