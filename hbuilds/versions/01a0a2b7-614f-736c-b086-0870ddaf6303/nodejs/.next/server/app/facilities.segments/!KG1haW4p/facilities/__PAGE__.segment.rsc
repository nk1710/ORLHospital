2:Tac4,{"@context":"https://schema.org","@type":"MedicalClinic","name":"Dr.(Prof.) Dhirendra Singh kushwah ENT Clinic","url":"https://www.drdhirendrasinghkushwah.in","logo":"https://www.drdhirendrasinghkushwah.in/images/logo.png","image":"https://www.drdhirendrasinghkushwah.in/images/clinic-facility.webp","description":"State-of-the-art ENT clinic offering advanced diagnostic and surgical care for pediatric and adult patients.","address":{"@type":"PostalAddress","streetAddress":"CR Park, Jasola, Arjune Nagar","addressLocality":"New Delhi","postalCode":"110019","addressCountry":"IN"},"telephone":"[Insert Phone Number]","medicalSpecialty":["Otolaryngology","Pediatric ENT","Audiology","Speech-Language Pathology","Sleep Medicine","Allergy & Immunology"],"availableService":[{"@type":"MedicalProcedure","name":"Endoscopic Sinus & Skull Base Surgery","description":"Minimally invasive surgery for nasal and sinus disorders using advanced endoscopic systems for precision and faster recovery."},{"@type":"MedicalProcedure","name":"Microscopic Ear Surgery","description":"High-magnification surgical treatment for hearing problems, chronic ear infections, and neuro-otologic disorders."},{"@type":"MedicalProcedure","name":"Laser & Radiofrequency Surgery (Coblation)","description":"Bloodless and minimally invasive procedures for tonsils, turbinates, and soft tissue ENT conditions."},{"@type":"MedicalProcedure","name":"Cochlear & Auditory Brainstem Implant Program","description":"Advanced implantable hearing solutions for severe to profound hearing loss, including post-implant programming and auditory verbal therapy."},{"@type":"MedicalProcedure","name":"Hearing Assessments","description":"PTA, Speech Audiograms, Impedance, ABR, ASSR, OAE, Tympanometry, and newborn hearing screening."},{"@type":"MedicalProcedure","name":"Allergy Testing & Management","description":"Blood tests and skin prick tests to identify allergy triggers, followed by personalized management plans."},{"@type":"MedicalProcedure","name":"Sleep & Snoring Assessment","description":"Sleep apnea and snoring evaluations using high-end monitoring tools to detect breathing irregularities."},{"@type":"MedicalProcedure","name":"Balance & Vertigo Testing","description":"Specialized testing to determine the cause of dizziness or vertigo for accurate treatment."},{"@type":"TherapeuticProcedure","name":"Speech & Language Therapy","description":"Therapy for articulation disorders, stuttering, voice disorders, feeding and swallowing challenges, and neurological speech issues."}],"openingHours":"Mo-Su 09:00-21:00","sameAs":["https://www.facebook.com/drdhirendrasinghkushwah","https://www.instagram.com/drdhirendrasinghkushwah","https://www.linkedin.com/in/drdhirendrasinghkushwah"]}0:{"buildId":"build-1789436362807","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","section",null,{"className":"relative facilities-banner w-full h-64 md:h-80 lg:h-100 overflow-hidden","children":["$","$L3",null,{"src":"/images/ORL-Hospital-Facility-ENT-Surgeon-Dr-Dhirendra-Singh-Kushwah.png","alt":"World-Class ENT Facilities","className":"absolute inset-0 w-full h-full object-cover object-center"}]}],["$","section",null,{"className":"condition-cnt","children":["$","div",null,{"className":"max-w-7xl text-gray-700 mx-auto px-4 py-8","children":["$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld"]}]}],"$Le"],["$Lf"],"$L10"]}],"loading":null,"isPartial":false}
