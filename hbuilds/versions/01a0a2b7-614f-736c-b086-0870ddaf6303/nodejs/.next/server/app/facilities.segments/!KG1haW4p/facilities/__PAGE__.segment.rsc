5:["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-10 items-center py-10 border-t border-gray-100","children":[["$","div",null,{"className":"relative rounded-2xl overflow-hidden shadow-md min-h-[320px] md:min-h-[440px]","children":["$","$L3",null,{"src":"/images/dhirendra kushwah.webp","alt":"Advanced ENT Diagnostic and Surgical Equipment","className":"w-full h-full object-cover"}]}],["$","div",null,{"className":"flex flex-col gap-4","children":[["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-gray-800 leading-snug","children":"World-Class ENT Care Facilities by Dr.(Prof.) Dhirendra Singh kushwah"}],["$","div",null,{"className":"w-12 h-0.5 bg-teal-600 rounded"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":["Choosing the right ENT doctor is one of the most important decisions you can make when dealing with problems related to the ear, nose, or throat. Dr.(Prof.) Dhirendra Singh kushwah, a trusted ENT specialist in New Delhi with over 25 years of experience, offers a comprehensive range of diagnostic and surgical facilities designed to deliver accurate diagnosis, advanced treatment, and long-term relief for both children and adults.",["$","br",null,{}],"At his clinics in CR Park and Arjun Nagar (Safdarjung Enclave), every patient is evaluated using modern, fully sterilised instruments in a safe, patient-centred environment. The facilities cover the full spectrum of ENT care - from routine consultations to complex cochlear implant surgeries and skull base procedures."]}]]}]]}]
6:["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-10 items-center py-10 border-t border-gray-100","children":[["$","div",null,{"className":"flex flex-col gap-4","children":[["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-gray-800 leading-snug","children":"Advanced Diagnostic Facilities for ENT Conditions"}],["$","div",null,{"className":"w-12 h-0.5 bg-teal-600 rounded"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Accurate diagnosis is the foundation of effective treatment. Dr.(Prof.) Dhirendra Singh kushwah's clinic is equipped with advanced diagnostic tools that make findings visual, transparent, and easy to understand for every patient."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-2","children":"Video Endoscopy of the Ear, Nose and Throat"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Video endoscopy allows Dr.(Prof.) Dhirendra Singh kushwah to examine the ear canal, nasal passages, and throat with a high-definition camera in real time. Patients can view their own findings on screen, making it easier to understand the diagnosis and follow through with the recommended treatment plan."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-2","children":"Allergy Testing — Blood Tests and Skin Prick Tests"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"For patients suffering from chronic nasal congestion, sneezing, or ear-related symptoms triggered by allergens, detailed allergy testing is available. Both blood tests and skin prick tests are used to accurately identify specific triggers, enabling targeted management rather than guesswork."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-2","children":"Snoring and Sleep Apnea Assessment"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Sleep-disordered breathing - including snoring and obstructive sleep apnea — is evaluated using high-end monitoring equipment. The assessment detects breathing irregularities during sleep and helps determine the severity of the condition, guiding decisions between medical management and surgical intervention."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-2","children":"Specialised Balance Testing for Dizziness and Vertigo"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Patients experiencing recurrent dizziness, spinning sensations, or balance problems can undergo dedicated neuro-otological balance testing. These tests identify whether the cause is inner-ear related (peripheral) or neurological (central), ensuring the right treatment pathway is chosen from the outset."}]]}],["$","div",null,{"className":"relative rounded-2xl overflow-hidden shadow-md min-h-[320px] md:min-h-[440px]","children":["$","$L3",null,{"src":"/images/fwdupdatesontheentswebsite/drdhirendrasinghkushwah-ENT-Surgeon.png","alt":"Advanced ENT Diagnostic and Surgical Equipment","className":"w-full h-full object-cover"}]}]]}]
7:["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-10 items-center py-10 border-t border-gray-100","children":[["$","div",null,{"className":"relative rounded-2xl overflow-hidden shadow-md min-h-[320px] md:min-h-[440px] order-2 md:order-1","children":["$","$L3",null,{"src":"/images/fwdupdatesontheentswebsite/facility9.png","alt":"Cochlear Implant and Hearing Program","className":"w-full h-full object-cover"}]}],["$","div",null,{"className":"flex flex-col gap-4 order-1 md:order-2","children":[["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-gray-800 leading-snug","children":"Advanced Surgical Facilities at Dr.(Prof.) Dhirendra Singh kushwah's ENT Clinic"}],["$","div",null,{"className":"w-12 h-0.5 bg-teal-600 rounded"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Dr.(Prof.) Dhirendra Singh kushwah performs a wide range of ENT surgeries using advanced equipment and minimally invasive techniques - reducing risk, improving outcomes, and helping patients recover faster."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-2","children":"Endoscopic Nose, Sinus and Skull Base Surgery"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"For patients with chronic sinusitis, nasal polyps, deviated septum, or skull base tumours, functional endoscopic sinus surgery (FESS) and extended endoscopic skull base surgery are performed using state-of-the-art endoscopic systems. These minimally invasive techniques offer high precision, minimal blood loss, and faster recovery compared to traditional open surgery."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-2","children":"Microscopic Ear Surgery"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Ear surgeries - including tympanoplasty, ossiculoplasty, mastoidectomy, and stapedotomy — are performed under high-magnification operating microscopes. This level of precision allows the surgeon to work on the delicate ossicles, eardrum, and middle ear structures safely, protecting hearing and minimising risk."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-2","children":"Laser and Radiofrequency (Coblation) Surgery"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Modern laser and radiofrequency coblation technology enables bloodless, minimally traumatic surgery on soft tissue structures including the tonsils, adenoids, nasal turbinates, and soft palate. These techniques reduce post-operative pain, bleeding, and recovery time — making them especially suitable for children and adults who prefer a gentler surgical option."}]]}]]}]
8:["$","div",null,{"className":"py-10 border-t border-gray-100","children":[["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-gray-800 leading-snug mb-4","children":"Cochlear Implant and Hearing Implant Programme"}],["$","div",null,{"className":"w-12 h-0.5 bg-teal-600 rounded mb-6"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md mb-4","children":"Dr.(Prof.) Dhirendra Singh kushwah runs one of India's most established cochlear implant and auditory brainstem implant programmes, with over 700 successful implant recipients. The programme is supported by a multidisciplinary team of surgeons, audiologists, and speech-language therapists working together to deliver reliable outcomes from surgery through to full rehabilitation."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-4","children":"Who Is This Programme For?"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md mb-4","children":"The cochlear implant programme is designed for children and adults with severe to profound sensorineural hearing loss who do not benefit adequately from conventional hearing aids. Early implantation in children, ideally before 18 months of age, leads to significantly better speech and language development outcomes."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-4","children":"Implantable Hearing Devices Available"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md mb-4","children":"When traditional hearing aids are not sufficient, implantable hearing devices offer life-changing results. Dr.(Prof.) Dhirendra Singh kushwah provides access to the following options:"}],["$","div",null,{"className":"space-y-3 mb-4","children":[["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"BAHA (Bone-Anchored Hearing Aid):"}]," A surgically implanted device that bypasses the outer and middle ear by transmitting sound vibrations directly to the cochlea through the skull bone. Ideal for patients with conductive or mixed hearing loss, or single-sided deafness."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Bonebridge:"}]," A fully implantable bone conduction hearing system with no external skin-penetrating component, offering a cleaner aesthetic and reduced risk of infection compared to traditional BAHA."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"VSB (Vibrant Soundbridge):"}]," A middle ear implant that directly stimulates the ossicular chain or round window, suitable for patients with sensorineural, conductive, or mixed hearing loss who cannot use conventional aids."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Cochlear Implant (CI):"}]," An electronic device that bypasses damaged hair cells in the cochlea and directly stimulates the auditory nerve, restoring meaningful hearing in patients with severe to profound hearing loss."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Auditory Brainstem Implant (ABI):"}]," For patients in whom the cochlear nerve is absent or non-functional (such as those with neurofibromatosis type 2), an ABI provides electrical stimulation directly at the cochlear nucleus in the brainstem."]}]]}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-4","children":"Post-Implant Rehabilitation and Programming"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md mb-4","children":"Receiving a cochlear implant is just the beginning. Long-term success depends on dedicated programming and auditory rehabilitation. Dr.(Prof.) Dhirendra Singh kushwah's team provides:"}],"$L11"]}]
9:["$","div",null,{"className":"py-10 border-t border-gray-100","children":[["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-gray-800 leading-snug mb-4","children":"Comprehensive Hearing Evaluation and Audiological Testing"}],["$","div",null,{"className":"w-12 h-0.5 bg-teal-600 rounded mb-6"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md mb-4","children":"Accurate hearing assessment is essential before any treatment decision is made. The clinic offers a full range of audiological tests for newborns, children, and adults."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-4","children":"Hearing Tests Offered"}],["$","div",null,{"className":"space-y-3 mb-4","children":[["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Pure Tone Audiogram (PTA):"}]," The standard hearing test that measures the softest sounds a person can hear across a range of frequencies, producing an audiogram that classifies the type and degree of hearing loss."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Speech Audiogram:"}]," Evaluates how well a person can hear and understand speech at different volume levels — essential for understanding real-world hearing ability."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Impedance Testing (Tympanometry):"}]," Measures the movement of the eardrum and checks for fluid in the middle ear, Eustachian tube dysfunction, or ossicular chain problems."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Auditory Brainstem Response (ABR):"}]," Records the brain's electrical response to sounds — used for hearing assessment in newborns, infants, and patients who cannot cooperate with standard tests."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Auditory Steady-State Response (ASSR):"}]," Provides frequency-specific hearing thresholds — particularly useful in young children and for planning cochlear implant candidacy."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Otoacoustic Emissions (OAE):"}]," A quick, non-invasive test that checks the function of the outer hair cells in the cochlea — a standard component of universal newborn hearing screening."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":[["$","strong",null,{"children":"Newborn Hearing Screening:"}]," Early detection of hearing loss at birth is critical. The clinic offers OAE and ABR-based newborn screening to identify hearing loss before a child reaches three months of age — maximising the window for early intervention."]}]]}]]}]
a:["$","div",null,{"className":"py-10 border-t border-gray-100","children":[["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-gray-800 leading-snug mb-4","children":"Speech and Language Therapy"}],["$","div",null,{"className":"w-12 h-0.5 bg-teal-600 rounded mb-6"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md mb-4","children":"Hearing well is only part of communication. Dr.(Prof.) Dhirendra Singh kushwah's clinic offers holistic speech and language therapy services delivered by skilled, experienced pathologists — supporting patients of all ages from early childhood through adulthood."}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-4","children":"Conditions Treated by Speech-Language Pathologists"}],["$","div",null,{"className":"space-y-2 mb-4","children":[["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Articulation and phonological disorders (unclear or delayed speech sounds)"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Stuttering and fluency difficulties"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Language delays and disorders in children"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Voice disorders including hoarseness, vocal nodules, and voice fatigue"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Neurological communication disorders (post-stroke, Parkinson's, TBI)"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Feeding and swallowing difficulties (dysphagia) in children and adults"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Autism-related communication challenges"}]]}],["$","h3",null,{"className":"text-lg font-semibold text-gray-800 mt-4","children":"Post-Cochlear Implant Speech Therapy"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md mb-4","children":"Children and adults who receive cochlear implants require dedicated speech therapy to maximise the benefit of their device. The therapy programme includes Auditory Verbal Therapy (AVT), spoken language development, phonics and reading readiness for children, and communication strategies for adults transitioning back to work or social environments."}]]}]
b:["$","div",null,{"className":"py-10 border-t border-gray-100","children":[["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-gray-800 leading-snug mb-4","children":"Why Choose Dr. Dhirendra Singh kushwah for ENT Treatment in New Delhi?"}],["$","div",null,{"className":"w-12 h-0.5 bg-teal-600 rounded mb-6"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md mb-4","children":"Dr.(Prof.) Dhirendra Singh kushwah is an otorhinolaryngologist with over 25 years of clinical and surgical experience. He completed his MBBS from Jiwaji University, Gwalior (1999) and his MS (ENT) from Rani Durgawati University, Jabalpur (2005). He is fluent in English and Hindi and is widely known for his compassionate care, tireless work ethic, and genuine commitment to each patient's recovery."}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md mb-4","children":"His clinics serve patients from across Delhi, NCR, and India — offering world-class ENT care in an accessible, patient-friendly setting."}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md font-semibold mb-2","children":"What sets Dr.(Prof.) Dhirendra Singh kushwah apart:"}],["$","div",null,{"className":"space-y-2","children":[["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Over 700 successful cochlear and auditory brainstem implant recipients"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Minimally invasive surgical approach across all procedures"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Transparent diagnosis using video endoscopy — patients see their own findings"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Multidisciplinary team covering surgery, audiology, and speech therapy under one roof"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Available in English and Hindi; accessible to patients from all backgrounds"}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-md","children":"Personally reachable and committed to being available for patients at any time"}]]}]]}]
c:["$","$L12",null,{"faqItems":[{"q":"What ENT surgical facilities are available at Dr.(Prof.) Dhirendra Singh kushwah's clinic?","a":"The clinic offers microscopic ear surgery, endoscopic sinus and skull base surgery, laser and coblation surgery, tympanoplasty, mastoidectomy, ossiculoplasty, stapedotomy, septoplasty, tonsillectomy, and cochlear implant surgery."},{"q":"Is cochlear implant surgery available for children at this clinic?","a":"Yes. Dr.(Prof.) Dhirendra Singh kushwah's cochlear implant programme caters to children from infancy through adolescence, as well as adults. The programme includes pre-implant evaluation, surgery, device programming, and long-term auditory verbal therapy."},{"q":"What hearing tests are available for newborns?","a":"Newborn hearing screening using OAE (Otoacoustic Emissions) and ABR (Auditory Brainstem Response) is available to detect hearing loss at birth, enabling early intervention before three months of age."},{"q":"Does the clinic offer speech therapy after cochlear implantation?","a":"Yes. Dedicated Auditory Verbal Therapy (AVT) and speech-language pathology services are available as part of the post-implant rehabilitation programme."},{"q":"Where are the clinics located?","a":"Dr.(Prof.) Dhirendra Singh kushwah operates from two locations: J-1981, Near Market No. 1, Below ICICI Bank, Bipin Chandra Pal Marg, CR Park, New Delhi – 110019; and 19-C, Arjun Nagar, Safdarjung Enclave, New Delhi – 110029."},{"q":"How do I book an appointment?","a":"Call or WhatsApp: +91-9311449825 | Email: drdhirendrasinghent@gmail.com"}]}]
