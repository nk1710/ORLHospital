19:["$","p",null,{"children":"Paediatric ENT focuses on the diagnosis and treatment of ear, nose and throat conditions affecting infants, toddlers, school-age children and teenagers. Children's ENT problems can sometimes present differently from those in adults and may affect hearing, speech, sleep, breathing, feeding, learning and everyday comfort."}]
1a:["$","p",null,{"children":"Common concerns include recurrent ear infections, hearing difficulty, fluid behind the eardrum, enlarged adenoids, enlarged tonsils, snoring, mouth breathing, allergies, persistent nasal blockage and recurrent throat infections."}]
1b:["$","p",null,{"children":"A timely ENT assessment can help identify the underlying cause and determine whether the child needs observation, medical treatment, hearing assessment, further investigation or a procedure."}]
