5:["$","section",null,{"className":"py-16 px-4 md:px-8 bg-gray-50","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-12 items-center","children":[["$","div",null,{"className":"flex flex-col gap-6","children":[["$","h2",null,{"className":"text-3xl font-bold text-gray-800","children":"What Is Rhinology? Understanding Nose and Sinus Care"}],["$","div",null,{"className":"w-16 h-1 bg-teal-600 rounded"}],["$","p",null,{"className":"text-gray-600 text-lg leading-relaxed","children":["Rhinology is the subspecialty of ENT medicine that focuses on the anatomy, physiology, and diseases of the nose and paranasal sinuses -  the air-filled cavities surrounding the nasal passage within the skull. A rhinologist is trained to manage everything from allergic rhinitis and nasal polyps to advanced endoscopic sinus surgery and skull base tumour removal.",["$","br",null,{}],["$","br",null,{}],"The nose does far more than allow you to smell. It filters, warms, and humidifies the air you breathe. When it is blocked, infected, or structurally abnormal, the consequences ripple outward -  affecting sleep, energy, concentration, hearing, and overall quality of life."]}],["$","div",null,{"className":"bg-teal-50 border-l-4 border-teal-600 p-6 rounded-r-xl","children":["$","p",null,{"className":"text-teal-900 font-medium italic","children":"\"Chronic sinusitis affects quality of life significantly. With modern endoscopic techniques, we can achieve lasting relief without extensive surgery.\""}]}]]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4","children":[["$","div",null,{"className":"bg-white p-6 rounded-2xl shadow-sm border border-gray-100","children":[["$","div",null,{"className":"w-10 h-10 bg-teal-100 text-teal-600 rounded-lg flex items-center justify-center mb-4","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-wind","aria-hidden":"true","children":[["$","path","148xed",{"d":"M12.8 19.6A2 2 0 1 0 14 16H2"}],["$","path","1u4tom",{"d":"M17.5 8a2.5 2.5 0 1 1 2 4H2"}],["$","path","75valh",{"d":"M9.8 4.4A2 2 0 1 1 11 8H2"}],"$undefined"]}]}],["$","h3",null,{"className":"font-bold text-gray-800 mb-2","children":"Chronic Sinusitis"}],["$","p",null,{"className":"text-sm text-gray-500","children":"Persistent inflammation requiring specialized evaluation and targeted treatment."}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl shadow-sm border border-gray-100","children":[["$","div",null,{"className":"w-10 h-10 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mb-4","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-wind","aria-hidden":"true","children":[["$","path","148xed",{"d":"M12.8 19.6A2 2 0 1 0 14 16H2"}],["$","path","1u4tom",{"d":"M17.5 8a2.5 2.5 0 1 1 2 4H2"}],["$","path","75valh",{"d":"M9.8 4.4A2 2 0 1 1 11 8H2"}],"$undefined"]}]}],["$","h3",null,{"className":"font-bold text-gray-800 mb-2","children":"Nasal Allergies"}],["$","p",null,{"className":"text-sm text-gray-500","children":"Comprehensive allergy management with medical and surgical options."}]]}]]}]]}]}]}]
6:["$","section",null,{"className":"py-20 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":[["$","div",null,{"className":"text-center mb-14","children":[["$","span",null,{"className":"text-teal-600 font-semibold uppercase tracking-wider text-sm","children":"Comprehensive Rhinology & Sinus Care"}],["$","h2",null,{"className":"text-3xl md:text-4xl font-bold text-gray-900 mt-2","children":"Nose & Sinus Conditions Treated by an ENT Specialist in Delhi"}],["$","p",null,{"className":"text-gray-600 max-w-3xl mx-auto mt-4 leading-relaxed","children":"Evaluation and treatment for nasal blockage, sinus problems, allergies, nasal polyps, smell disorders, nosebleeds and other conditions affecting the nose and paranasal sinuses in children and adults."}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6","children":[["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Chronic Sinusitis (Chronic Rhinosinusitis)"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Chronic sinusitis is persistent inflammation of the nose and sinuses, generally lasting 12 weeks or longer. Common symptoms include nasal blockage, thick nasal discharge, facial pressure, reduced sense of smell, headache and post-nasal drip. Causes may include nasal polyps, allergies, a deviated septum and ongoing inflammation. Assessment may involve nasal endoscopy and, when appropriate, CT imaging. Treatment can include medicines, saline irrigation, nasal sprays and surgery such as Functional Endoscopic Sinus Surgery (FESS) when indicated."}]]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Nasal Polyps"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Nasal polyps are soft, non-cancerous growths associated with chronic inflammation of the nasal and sinus lining. They may cause persistent nasal obstruction, reduced smell, mouth breathing, post-nasal drip and recurrent sinus symptoms. Treatment depends on the size and severity of the polyps and may include saline irrigation, intranasal corticosteroids and other medical therapy. Selected patients with persistent or extensive disease may require endoscopic sinus surgery, while advanced recurrent disease may be considered for biologic treatment where appropriate."}]]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Deviated Nasal Septum (DNS)"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"A deviated nasal septum occurs when the cartilage and bone dividing the nasal passages are displaced from the midline. A significant deviation may contribute to one-sided or bilateral nasal obstruction, mouth breathing, disturbed sleep, recurrent nasal symptoms and difficulty breathing during exercise. Diagnosis is based on clinical examination and nasal assessment. When symptoms are caused by structural obstruction and do not improve adequately with medical treatment, septoplasty may be considered to improve nasal airflow."}]]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b"]}]]}]}]
