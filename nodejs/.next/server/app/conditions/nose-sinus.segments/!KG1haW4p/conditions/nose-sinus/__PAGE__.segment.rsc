-relaxed mt-4","children":"Patients with persistent nasal blockage, sinus symptoms, nasal allergies, nasal polyps, deviated nasal septum, recurrent sinus problems or reduced sense of smell can undergo an appropriate ENT assessment before treatment options are recommended."}]]}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"flex gap-5 items-start","children":[["$","div",null,{"className":"flex-shrink-0 w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-slate-900 flex items-center justify-center shadow-md","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-award text-teal-400 w-6 h-6","aria-hidden":"true","children":[["$","path","1yiouv",{"d":"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"}],["$","circle","1vp47v",{"cx":"12","cy":"8","r":"6"}],"$undefined"]}]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-lg font-bold text-gray-800 mb-1","children":"15+ Years in Rhinology"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Specialist training from Graz University, Austria in advanced sinus surgery."}]]}]]}],["$","div","1",{"className":"flex gap-5 items-start","children":[["$","div",null,{"className":"flex-shrink-0 w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-slate-900 flex items-center justify-center shadow-md","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-activity text-teal-400 w-6 h-6","aria-hidden":"true","children":[["$","path","169zse",{"d":"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.