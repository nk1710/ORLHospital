10:["$","$L2d",null,{"children":["$","$2e",null,{"name":"Next.MetadataOutlet","children":"$@2f"}]}]
11:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Allergic Rhinitis (Nasal Allergy)"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Allergic rhinitis develops when the immune system reacts to airborne allergens such as dust mites, pollen, mould or pet dander. Typical symptoms include repeated sneezing, nasal itching, watery discharge, congestion and itchy or watery eyes. Allergy assessment may help identify relevant triggers. Treatment can include allergen avoidance, antihistamines, intranasal corticosteroids and, in selected patients, allergen immunotherapy."}]]}]
12:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Enlarged Turbinates (Turbinate Hypertrophy)"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Turbinates are structures inside the nose that help warm, humidify and filter inhaled air. Persistent enlargement, often associated with allergies or chronic nasal inflammation, can contribute to nasal blockage and difficulty breathing. Treatment depends on the underlying cause and may include allergy management, nasal medication or turbinate reduction procedures in appropriately selected patients."}]]}]
13:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Sinusitis, Facial Pain & Sinus Headaches"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Facial pressure or headache may occur with sinus inflammation, particularly when accompanied by nasal blockage, discharge or reduced smell. However, many headaches described as \"sinus headaches\" are actually related to migraine or other headache disorders. A detailed history and ENT examination, with nasal endoscopy or imaging when indicated, can help identify whether the symptoms are related to sinus disease or another condition."}]]}]
14:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Loss of Smell (Anosmia & Hyposmia)"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Anosmia means complete loss of smell, while hyposmia refers to reduced ability to smell. Causes may include nasal polyps, chronic rhinosinusitis, allergic inflammation, viral infections, head injury and certain neurological conditions. Treatment depends on the underlying cause and may include management of nasal inflammation, treatment of sinus disease and olfactory training when appropriate."}]]}]
15:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Post-Nasal Drip"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Post-nasal drip describes the sensation of mucus draining from the nose or sinuses towards the throat. It may cause frequent throat clearing, cough, throat irritation or a sensation of mucus in the throat. Allergic rhinitis, non-allergic rhinitis and chronic sinus conditions can contribute to these symptoms. Treatment focuses on identifying and managing the underlying nasal or sinus problem."}]]}]
16:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Nosebleeds (Epistaxis)"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Nosebleeds are common and may occur because of nasal dryness, irritation, trauma, nose picking, allergies or other nasal conditions. Most bleeding originates from blood vessels near the front of the nasal septum. Recurrent, prolonged or heavy bleeding requires ENT evaluation to identify the source and determine appropriate treatment, which may include local measures or nasal cauterisation."}]]}]
17:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Nasal Fracture & Nasal Trauma"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Nasal injuries can result from falls, sports injuries, road accidents or other trauma. Pain, swelling, bruising, nasal deformity and difficulty breathing may occur. Early ENT assessment is important to evaluate the nasal bones and septum and to identify complications such as a septal haematoma. Treatment depends on the type and severity of injury and may range from observation to fracture reduction or corrective surgery."}]]}]
18:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Sinusitis in Children"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Children can develop prolonged or recurrent nasal and sinus symptoms, including persistent nasal discharge, congestion, cough, mouth breathing and disturbed sleep. Enlarged adenoids, allergies and recurrent infections may contribute to symptoms. Paediatric assessment helps determine whether medical treatment, allergy management, adenoid evaluation or another approach is appropriate."}]]}]
19:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Recurrent Sinus Infections"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Repeated episodes of sinus infection may be associated with allergies, nasal obstruction, anatomical variations, nasal polyps or other underlying factors. A detailed ENT assessment can help identify contributing causes and distinguish recurrent sinusitis from repeated viral upper-respiratory infections. Treatment is tailored to the cause and may include medical management, allergy treatment or surgery in selected cases."}]]}]
1a:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Nasal Blockage & Nasal Obstruction"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Persistent difficulty breathing through the nose may result from a deviated septum, enlarged turbinates, nasal polyps, allergies, chronic sinus inflammation or other structural problems. Nasal obstruction can affect sleep, exercise, breathing comfort and quality of life. ENT examination and nasal endoscopy can help identify the underlying cause and guide appropriate treatment."}]]}]
1b:["$","div",null,{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Fungal Sinusitis"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Fungal involvement of the sinuses includes several different clinical conditions, ranging from non-invasive fungal disease to more serious invasive infections. Symptoms may include persistent nasal blockage, facial pressure, discharge or reduced smell. Diagnosis depends on the clinical presentation, endoscopic findings and imaging. Treatment varies according to the type of fungal sinus disease and may include medication, endoscopic surgery or specialist management."}]]}]
1c:["$","div","7",{"className":"bg-white p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Mouth Breathing"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Difficulty breathing through the nose may lead to habitual mouth breathing, particularly during sleep, and may be associated with nasal obstruction."}]]}]
1d:["$","div","8",{"className":"bg-white p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Snoring"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Nasal obstruction can contribute to mouth breathing and snoring. Persistent snoring, especially with disturbed sleep, may require evaluation for sleep-related breathing problems."}]]}]
1e:["$","div","9",{"className":"bg-white p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Nosebleeds"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Repeated nosebleeds may be associated with dryness, irritation, allergies, trauma, nasal inflammation or other nasal conditions and should be assessed when recurrent."}]]}]
1f:["$","div","10",{"className":"bg-white p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Recurrent Sinus Infections"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Repeated episodes of nasal blockage, discharge, facial pressure or other sinus symptoms may require evaluation to identify contributing factors."}]]}]
20:["$","div","11",{"className":"bg-white p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Difficulty Breathing Through the Nose"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Long-standing nasal breathing difficulty may result from structural problems, allergies, turbinate enlargement, polyps or chronic nasal and sinus inflammation."}]]}]
21:["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Endoscopic Nasal Polyp Removal"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed mb-4","children":"Nasal polyps are non-cancerous inflammatory growths that can cause nasal blockage, reduced sense of smell and persistent sinus symptoms. When surgery is appropriate, polyps can be removed using an endoscopic technique, with treatment directed at the underlying nasal and sinus disease."}],["$","ul",null,{"className":"space-y-2 text-sm text-gray-600","children":[["$","li",null,{"children":"• Endoscopic removal of obstructive nasal polyps"}],["$","li",null,{"children":"• May be combined with sinus surgery when indicated"}],["$","li",null,{"children":"• Can help improve nasal airflow and access to the sinuses"}],["$","li",null,{"children":"• Ongoing medical management may be needed after surgery"}]]}]]}]
22:["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Balloon Sinuplasty"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed mb-4","children":"Balloon sinuplasty uses a small balloon catheter to widen the drainage pathway of selected sinuses. It may be considered for carefully selected patients depending on the sinus involved, anatomy, symptoms and underlying disease."}],["$","ul",null,{"className":"space-y-2 text-sm text-gray-600","children":[["$","li",null,{"children":"• Minimally invasive endoscopic technique"}],["$","li",null,{"children":"• Uses a small balloon catheter to widen the sinus opening"}],["$","li",null,{"children":"• Suitable only for selected sinus conditions"}],["$","li",null,{"children":"• Suitability is determined after clinical evaluation"}]]}]]}]
23:["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Endoscopic Skull Base Surgery"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed mb-4","children":"Endoscopic skull base surgery uses the nasal and sinus passages to access selected conditions involving the skull base. Depending on the diagnosis, surgery may be considered for conditions such as certain skull base tumours or cerebrospinal fluid (CSF) leaks."}],["$","ul",null,{"className":"space-y-2 text-sm text-gray-600","children":[["$","li",null,{"children":"• Endoscopic access through the nasal passages"}],["$","li",null,{"children":"• Used for selected skull base conditions"}],["$","li",null,{"children":"• May involve multidisciplinary surgical care"}],["$","li",null,{"children":"• Treatment planning depends on imaging and diagnosis"}]]}]]}]
