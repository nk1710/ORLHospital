","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Septoplasty – Deviated Nasal Septum Surgery"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed mb-4","children":"Septoplasty is performed to correct a deviated nasal septum that contributes to persistent nasal obstruction or breathing difficulty. The procedure reshapes or removes selected portions of the septal cartilage and bone to improve the nasal airway while preserving appropriate nasal structure."}],["$","ul",null,{"className":"space-y-2 text-sm text-gray-600","children":[["$","li",null,{"children":"• Treats symptomatic deviated nasal septum (DNS)"}],["$","li",null,{"children":"• Aims to improve nasal airflow"}],["$","li",null,{"children":"• Usually performed through the inside of the nose"}],["$","li",null,{"children":"• May be combined with turbinate treatment when appropriate"}]]}]]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Turbinate Reduction"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed mb-4","children":"Enlarged nasal turbinates can contribute to chronic nasal blockage and difficulty breathing through the nose. Turbinate reduction aims to reduce excessive tissue volume while preserving the normal function of the nasal lining."}],["$","ul",null,{"className":"space-y-2 text-sm text-gray-600","children":[["$","li",null,{"children":"• Used for selected cases of turbinate hypertrophy"}],["$","li",null,{"children":"• Can help improve nasal airway space"}],["$","li",null,{"children":"• Radiofrequency techniques may be used in suitable patients"}],["$","li",null,{"children":"• Technique depends on the patient's nasal anatomy and condition"}]]}]]}],"$L21","$L22","$L23"]}]]}]}]
a:["$","section",null,{"className":"py-16 px-4 md:px-8 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":["$","div",null,{"className":"bg-teal-50 rounded-3xl p-8 md:p-12","children":[["$","h2",null,{"className":"text-3xl md:text-4xl font-bold text-gray-800 mb-6","children":"When Should You See a Nose & Sinus Specialist in Delhi?"}],["$","p",null,{"className":"text-gray-700 text-lg leading-relaxed mb-6","children":"Persistent or recurrent nasal and sinus symptoms can affect breathing, sleep, smell and everyday comfort. Consider an ENT evaluation with Dr. Dhirendra Singh Kushwah if you experience any of the following:"}],["$","ul",null,{"className":"space-y-3 mb-6 text-gray-700","children":[["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"text-teal-700 font-bold mt-1","children":"✓"}],["$","span",null,{"children":[["$","strong",null,{"children":"Persistent nasal blockage or congestion"}]," affecting one or both sides of the nose."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"text-teal-700 font-bold mt-1","children":"✓"}],["$","span",null,{"children":[["$","strong",null,{"children":"Facial pain, pressure or heaviness"}]," around the forehead, cheeks, nose or eyes."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"text-teal-700 font-bold mt-1","children":"✓"}],["$","span",null,{"children":[["$","strong",null,{"children":"Persistent or recurrent nasal discharge"}],", particularly when associated with congestion or facial pressure."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"text-teal-700 font-bold mt-1","children":"✓"}],["$","span",null,{"children":[["$","strong",null,{"children":"Reduced or loss of smell"}]," that persists or keeps returning."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",nu