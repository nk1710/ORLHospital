18:["$","div","7",{"className":"bg-gray-50 p-6 rounded-2xl border border-gray-100 hover:border-teal-200 hover:shadow-md transition-all","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-800 mb-3","children":"Difficulty Swallowing (Dysphagia)"}],["$","p",null,{"className":"text-gray-600 text-sm leading-relaxed","children":"Difficulty swallowing food, liquids or saliva can have many causes. Persistent dysphagia, choking, coughing while eating or unexplained weight loss should be medically assessed to identify the cause and reduce the risk of complications."}]]}]
