2:T1710,{"@context":"https://schema.org","@type":"MedicalBusiness","@id":"https://www.drdhirendrasinghkushwah.in/specialities/#medicalbusiness","name":"Dr.(Prof.) Dhirendra Singh Kushwah - ENT Super-Specialities Department","url":"https://www.drdhirendrasinghkushwah.in/specialities","telephone":"+91-9311449825","image":"https://www.drdhirendrasinghkushwah.in/images/gallery/11.webp","medicalSpecialty":["Otolaryngology","PediatricOtolaryngology","HeadAndNeckSurgery","Neurotology"],"description":"World-class super-speciality ENT surgical care department headed by Dr.(Prof.) Dhirendra Singh Kushwah. Providing Cochlear Implants, Micro-Ear Surgery, FESS, Packless Septoplasty, Skull Base Surgery, and Coblation Tonsillectomy in Delhi NCR.","address":{"@type":"PostalAddress","streetAddress":"Plot No. 89, Pocket 1, Jasola Vihar","addressLocality":"New Delhi","addressRegion":"Delhi","postalCode":"110025","addressCountry":"IN"},"hasOfferCatalog":{"@type":"OfferCatalog","name":"Advanced ENT Surgical Procedures","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Cochlear & Hearing Implants","description":"Life-transforming bionic hearing restoration for infants, children, and adults with severe-to-profound sensorineural deafness. Comprehensive pre-implant evaluation and post-activation rehabilitation.","url":"https://www.drdhirendrasinghkushwah.in/specialities/cochlear-hearing-implants"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Ear Surgery & Micro-Otology","description":"Precision microscopic treatment for chronic ear discharge (CSOM), ear drum perforations, cholesteatoma, hearing loss, and ossicular chain defects.","url":"https://www.drdhirendrasinghkushwah.in/specialities/otology"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Tympanoplasty Surgery","description":"State-of-the-art eardrum grafting and reconstruction surgery to stop recurrent ear discharge, eliminate pain, and restore crisp natural acoustic clarity.","url":"https://www.drdhirendrasinghkushwah.in/specialities/tympanoplasty-surgery"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Ossiculoplasty Surgery","description":"Precision reconstruction of damaged middle ear tiny bones (Malleus, Incus, Stapes) using titanium/TORP/PORP prostheses to restore mechanical hearing conduction.","url":"https://www.drdhirendrasinghkushwah.in/specialities/ossiculoplasty-surgery"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Mastoidectomy Surgery","description":"Complete surgical clearance of cholesteatoma and deep-seated bone infection from the mastoid air cells, safeguarding the facial nerve and brain cavity.","url":"https://www.drdhirendrasinghkushwah.in/specialities/mastoidectomy"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Stapedotomy Surgery","description":"Microscopic laser or fenestration surgery for Otosclerosis (fixed stapes bone). Replaces frozen bone with a Teflon or titanium piston for instant hearing restoration.","url":"https://www.drdhirendrasinghkushwah.in/specialities/stapedotomy-surgery"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Nose & Sinus (Rhinology & FESS)","description":"Advanced Functional Endoscopic Sinus Surgery (FESS) for chronic sinusitis, polyposis, recurrent fungal infections, sinus headaches, and nasal blockages.","url":"https://www.drdhirendrasinghkushwah.in/specialities/nose-sinus-rhinology"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Pain-Free Packless Septoplasty","description":"Revolutionary packless septoplasty technique for deviated nasal septum (DNS). Straightens nasal airflow without the agonizing pain of traditional nasal packing.","url":"https://www.drdhirendrasinghkushwah.in/specialities/septoplasty"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Skull Base Surgery","description":"Multidisciplinary endoscopic transnasal approach to pituitary tumours, CSF rhinorrhea leaks, angiofibromas, and anterior skull base lesions without craniotomy.","url":"https://www.drdhirendrasinghkushwah.in/specialities/skull-base-surgery"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Head & Neck Surgery & Oncology","description":"Comprehensive surgical management of neck lumps, thyroid nodules, parotid salivary gland tumours, laryngeal growths, and oral cavity lesions.","url":"https://www.drdhirendrasinghkushwah.in/specialities/head-neck-surgery"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Voice & Throat (Laryngology)","description":"Specialized phonosurgery for professional voice users, vocal cord polyps, nodules, cysts, sulcus vocalis, hoarseness, and spasmodic dysphonia.","url":"https://www.drdhirendrasinghkushwah.in/specialities/laryngology"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Advanced Coblation Tonsillectomy","description":"Gentle plasma-field Coblation technology for recurrent tonsillitis, enlarged kissing tonsils, and adenoid hypertrophy in pediatric and adult patients.","url":"https://www.drdhirendrasinghkushwah.in/specialities/tonsillectomy-surgery"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Pediatric ENT & Airway Clinic","description":"Compassionate, child-friendly care for mouth breathing, childhood snoring, glue ear, adenoids, congenital stridor, foreign body removal, and speech delays.","url":"https://www.drdhirendrasinghkushwah.in/specialities/pediatric-ent"}},{"@type":"Offer","itemOffered":{"@type":"MedicalProcedure","name":"Dizziness & Vertigo (Neuro-Otology)","description":"Accurate vestibular assessment and therapeutic maneuvers for BPPV, Meniere's disease, vestibular neuritis, labyrinthitis, and unexplained balance imbalance.","url":"https://www.drdhirendrasinghkushwah.in/specialities/neuro-otology"}}]}}0:{"buildId":"build-1792603351652","rsc":["$","$1","c",{"children":[[["$","script",null,