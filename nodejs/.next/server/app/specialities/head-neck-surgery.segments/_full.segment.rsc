27:Te9f,{"@context":"https://schema.org","@graph":[{"@type":"MedicalWebPage","@id":"https://www.drdhirendrasinghkushwah.in/head-neck-surgery","url":"https://www.drdhirendrasinghkushwah.in/head-neck-surgery","name":"Head and Neck Surgery Specialist in India – Dr Dhirendra Singh Kushwah","description":"Expert head and neck surgery in India for thyroid disorders, tumors, airway problems, salivary gland diseases, and complex reconstructive procedures by Dr. Dhirendra Singh Kushwah.","mainEntity":{"@id":"https://www.drdhirendrasinghkushwah.in/#headneck-surgery"}},{"@type":"MedicalProcedure","@id":"https://www.drdhirendrasinghkushwah.in/#headneck-surgery","name":"Head and Neck Surgery","alternateName":"ENT Head & Neck Procedures","description":"Surgical procedures for conditions affecting the head and neck, including tumors, thyroid disorders, voice and airway issues, and salivary gland diseases, using modern minimally invasive techniques.","procedureType":"SurgicalProcedure","bodyLocation":"Head, Neck","howPerformed":"Performed using advanced surgical techniques, minimally invasive approaches where possible, and personalized care for safe, effective treatment.","preparation":"Patients undergo preoperative evaluation including imaging, lab tests, and consultation for a customized surgical plan.","followup":"Postoperative care includes wound monitoring, medications, rehabilitation, and follow-up consultations to ensure recovery and long-term health.","indication":["Thyroid disorders","Head and neck tumors","Voice disorders","Salivary gland diseases","Neck masses","Complex airway problems"],"physician":{"@id":"https://www.drdhirendrasinghkushwah.in/#physician"}},{"@type":"Physician","@id":"https://www.drdhirendrasinghkushwah.in/#physician","name":"Dr. Dhirendra Singh Kushwah","medicalSpecialty":"Otolaryngology","jobTitle":"Head and Neck Surgery Specialist","url":"https://www.youtube.com/@dr.dhirendrasingh"},{"@type":"VideoObject","name":"Head and Neck Surgery Explained","de