28:["$","main",null,{"className":"max-w-6xl mx-auto px-4 py-8 space-y-12","children":[["$","section",null,{"children":[["$","p",null,{"className":"text-sm text-gray-500 mb-2","children":"Ossiculoplasty Surgeon in Delhi, India"}],["$","h1",null,{"className":"text-3xl md:text-4xl font-bold leading-tight","children":"Best Ossiculoplasty Surgeon in Delhi | Hearing Reconstruction Surgery – Dr. Dhirendra Singh Kushwah"}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-5","children":"Dr. Dhirendra Singh Kushwah is an experienced ENT surgeon in Delhi providing evaluation and surgical management of middle-ear conditions, ossicular damage and conductive hearing loss. Ossiculoplasty is a reconstructive ear surgery designed to repair or reconstruct damaged or disrupted middle-ear bones when appropriate."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mt-4","children":["If you are searching for an"," ",["$","strong",null,{"children":"Ossiculoplasty Surgeon in Delhi"}],","," ",["$","strong",null,{"children":"middle-ear surgeon in Delhi"}],", or"," ",["$","strong",null,{"children":"hearing reconstruction specialist"}],", an ENT evaluation can determine whether ossiculoplasty or another hearing treatment is suitable for your condition."]}]]}],["$","section",null,{"className":"bg-gray-50 rounded-2xl p-6 md:p-8 border","children":[["$","h2",null,{"className":"text-2xl font-bold mb-4","children":"What Is Ossiculoplasty?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":[["$","strong",null,{"children":"Ossiculoplasty is surgery to repair or reconstruct damaged middle-ear bones."}]," ","The procedure is used in selected patients when damage or disruption of the ossicles contributes to conductive hearing loss. The aim is to restore the connection that transmits sound vibrations through the middle ear."]}]]}],["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"What Are the Ossicles in the Ear?"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"The middle ear contains three tiny bones called the ossicles. They are known as the malleus, incus and stapes. These small bones work together to transmit sound vibrations from the eardrum toward the inner ear."}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Malleus:"}]," connected to the eardrum"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Incus:"}]," connects the malleus and stapes"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Stapes:"}]," transmits vibrations toward the inner ear"]}]]}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Damage or interruption of this chain can reduce the efficient transmission of sound and may result in conductive hearing loss."}]]}],["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Symptoms of Ossicular Chain Damage"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Ossicular damage does not always cause pain. The most common problem is reduced sound transmission through the middle ear, resulting in conductive hearing loss."}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Muffled or reduced hearing"}],["$","li",null,{"children":"Difficulty understanding conversations"}],["$","li",null,{"children":"Feeling that sounds are unusually faint"}],["$","li",null,{"children":"One-sided hearing loss"}],["$","li",null,{"children":"Hearing loss following ear trauma"}],["$","li",null,{"children":"Hearing loss after chronic ear infection"}],["$","li",null,{"children":"Persistent ear problems after previous ear surgery"}],["$","li",null,{"children":"Ear discharge when associated with chronic middle-ear disease"}],"$L2b"]}],"$L2c"]}],"$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c"]}]
