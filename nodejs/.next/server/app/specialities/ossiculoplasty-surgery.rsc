30:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"How Is Ossicular Damage Diagnosed?"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Diagnosis begins with a detailed history and examination of the ear. The ENT surgeon assesses the eardrum, middle ear and hearing function before deciding whether reconstruction may be useful."}],["$","h3",null,{"className":"text-xl font-semibold","children":"Tests May Include"}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Detailed ENT examination"}],["$","li",null,{"children":"Microscopic ear examination"}],["$","li",null,{"children":"Pure tone audiometry"}],["$","li",null,{"children":"Speech audiometry when appropriate"}],["$","li",null,{"children":"Tympanometry"}],["$","li",null,{"children":"Additional imaging when clinically indicated"}]]}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"The exact tests depend on the patient's symptoms, previous ear history and suspected middle-ear disease."}]]}]
31:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Ossiculoplasty Treatment Options"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Treatment depends on the underlying cause of hearing loss. Ossiculoplasty is only one of several possible management options. An ENT specialist may recommend observation, treatment of active ear disease, hearing rehabilitation or reconstructive surgery depending on the individual case."}],["$","h3",null,{"className":"text-xl font-semibold","children":"Treatment May Include"}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Treatment of active middle-ear infection"}],["$","li",null,{"children":"Management of chronic ear disease"}],["$","li",null,{"children":"Tympanoplasty when the eardrum requires repair"}],["$","li",null,{"children":"Ossicular chain reconstruction"}],["$","li",null,{"children":"Hearing aids when appropriate"}],["$","li",null,{"children":"Other hearing restoration options depending on the cause"}]]}]]}]
32:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"How Is Ossiculoplasty Surgery Performed?"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Ossiculoplasty is performed to reconstruct the sound-conducting mechanism of the middle ear. Depending on the condition, the surgeon may repair or reconstruct the connection between the remaining ossicles, eardrum and inner-ear interface using an appropriate reconstructive technique or prosthetic material."}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"The surgical approach depends on the anatomy of the ear, the condition of the ossicles, previous surgery, the status of the eardrum and the underlying disease."}],["$","h3",null,{"className":"text-xl font-semibold","children":"Main Goals of Ossiculoplasty"}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Reconstruct the middle-ear sound pathway"}],["$","li",null,{"children":"Restore continuity of the ossicular chain where possible"}],["$","li",null,{"children":"Improve conductive hearing when possible"}],["$","li",null,{"children":"Treat associated middle-ear disease"}],["$","li",null,{"children":"Improve functional hearing in appropriately selected patients"}]]}]]}]
33:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Benefits of Ossiculoplasty"}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Reconstruction of damaged middle-ear structures"}],["$","li",null,{"children":"Potential improvement in conductive hearing loss"}],["$","li",null,{"children":"Restoration of the sound transmission mechanism"}],["$","li",null,{"children":"Improved hearing in appropriately selected patients"}],["$","li",null,{"children":"May be combined with other middle-ear procedures when required"}]]}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Hearing improvement varies between patients. The final outcome depends on the condition of the middle ear, inner ear, eardrum, ossicles and the underlying cause of hearing loss."}]]}]
34:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Ossiculoplasty Recovery Time"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Initial healing generally takes several weeks. Hearing may not improve immediately because the reconstructed middle ear needs time to heal and stabilise."}],["$","h3",null,{"className":"text-xl font-semibold","children":"During Recovery"}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Attend all scheduled follow-up appointments"}],["$","li",null,{"children":"Use prescribed medicines as directed"}],["$","li",null,{"children":"Keep the operated ear protected as advised"}],["$","li",null,{"children":"Do not put anything into the ear unless instructed"}],["$","li",null,{"children":"Follow activity and water precautions provided by your surgeon"}],["$","li",null,{"children":"Complete recommended hearing assessments"}]]}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Hearing assessment after healing helps determine the functional result of the reconstruction."}]]}]
35:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Possible Risks and Limitations of Ossiculoplasty"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Like other ear surgeries, ossiculoplasty has potential risks. The specific risks depend on the underlying disease, anatomy and surgical technique."}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Temporary pain or discomfort"}],["$","li",null,{"children":"Bleeding"}],["$","li",null,{"children":"Infection"}],["$","li",null,{"children":"Persistent hearing loss"}],["$","li",null,{"children":"Incomplete hearing improvement"}],["$","li",null,{"children":"Movement or displacement of a reconstruction or prosthesis"}],["$","li",null,{"children":"Need for additional treatment or surgery in selected cases"}]]}]]}]
36:["$","section",null,{"className":"bg-red-50 rounded-2xl p-6 md:p-8 border border-red-100 space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"When Should You See an ENT Doctor for Hearing Loss?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Persistent hearing problems should not be ignored, particularly when they affect one ear or occur after chronic ear disease or trauma."}],["$","ul",null,{"className":"list-disc pl-6 text-gray-700 space-y-2","children":[["$","li",null,{"children":"Persistent or worsening hearing loss"}],["$","li",null,{"children":"Hearing loss in only one ear"}],["$","li",null,{"children":"Hearing loss following an ear injury"}],["$","li",null,{"children":"Repeated ear infections"}],["$","li",null,{"children":"Chronic ear discharge"}],["$","li",null,{"children":"Known damage to the eardrum or middle ear"}],["$","li",null,{"children":"Hearing loss following previous ear surgery"}],["$","li",null,{"children":"Sudden hearing changes"}],["$","li",null,{"children":"Difficulty understanding normal conversations"}],["$","li",null,{"children":"Hearing difficulty that affects work or daily communication"}]]}],["$","p",null,{"className":"text-gray-700 font-medium leading-relaxed","children":"Early ENT evaluation can help determine whether hearing loss is related to the outer ear, eardrum, middle-ear bones or inner ear and guide the appropriate treatment."}]]}]
37:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Ossiculoplasty vs Tympanoplasty"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Tympanoplasty primarily focuses on repairing a damaged or perforated eardrum, while ossiculoplasty focuses on repairing or reconstructing the tiny bones responsible for sound transmission through the middle ear."}],["$","div",null,{"className":"overflow-x-auto","children":["$","table",null,{"className":"w-full border-collapse border","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"className":"border p-3 text-left","children":"Procedure"}],["$","th",null,{"className":"border p-3 text-left","children":"Main Target"}],["$","th",null,{"className":"border p-3 text-left","children":"Main Purpose"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"className":"border p-3","children":"Tympanoplasty"}],["$","td",null,{"className":"border p-3","children":"Eardrum"}],["$","td",null,{"className":"border p-3","children":"Repair eardrum perforation"}]]}],["$","tr",null,{"children":[["$","td",null,{"className":"border p-3","children":"Ossiculoplasty"}],["$","td",null,{"className":"border p-3","children":"Middle-ear ossicles"}],["$","td",null,{"className":"border p-3","children":"Reconstruct sound transmission"}]]}]]}]]}]}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"In some patients, both procedures may be performed as part of the same middle-ear operation when both the eardrum and ossicular chain require reconstruction."}]]}]
