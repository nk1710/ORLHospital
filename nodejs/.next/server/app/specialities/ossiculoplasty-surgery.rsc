2c:["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Because similar symptoms can occur with other ear conditions, hearing loss should be evaluated by an ENT specialist rather than assuming that the ossicles are damaged."}]
2d:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"What Causes Ossicular Damage?"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"The tiny bones of the middle ear can become damaged, displaced or disconnected due to several ear conditions."}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Chronic middle-ear infection"}],["$","li",null,{"children":"Cholesteatoma and chronic ear disease"}],["$","li",null,{"children":"Trauma to the ear or head"}],["$","li",null,{"children":"Previous middle-ear surgery"}],["$","li",null,{"children":"Long-standing eardrum problems"}],["$","li",null,{"children":"Damage associated with chronic ear inflammation"}],["$","li",null,{"children":"Other structural abnormalities of the middle ear"}]]}]]}]
2e:["$","section",null,{"className":"space-y-5","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Ossiculoplasty and Conductive Hearing Loss"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Conductive hearing loss occurs when sound is not efficiently transmitted through the outer or middle ear. Problems involving the eardrum or ossicles can interfere with the normal movement of sound vibrations."}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"When hearing loss is caused by ossicular disruption, reconstructive surgery may be considered after a detailed examination and hearing assessment."}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"Ossiculoplasty is therefore different from procedures designed primarily for sensorineural hearing loss, such as cochlear implantation."}]]}]
