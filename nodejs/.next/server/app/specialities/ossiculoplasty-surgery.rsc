3b:["$","section",null,{"className":"space-y-6","children":[["$","h2",null,{"className":"text-2xl font-bold","children":"Frequently Asked Questions About Ossiculoplasty"}],["$","div",null,{"className":"space-y-6","children":[["$","div",null,{"children":[["$","h3",null,{"className":"text-lg font-semibold","children":"What is ossiculoplasty surgery?"}],["$","p",null,{"className":"text-gray-600 mt-2 leading-relaxed","children":"Ossiculoplasty is a reconstructive middle-ear surgery used to repair or reconstruct damaged or disrupted ossicles. It may be performed to improve sound transmission in selected patients with conductive hearing loss."}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-lg font-semibold","children":"What are the three ossicles?"}],["$","p",null,{"className":"text-gray-600 mt-2 leading-relaxed","children":"The three middle-ear bones are the malleus, incus and stapes. Together they transmit sound vibrations from the eardrum toward the inner ear."}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-lg font-semibold","children":"Does ossiculoplasty restore hearing?"}],["$","p",null,{"className":"text-gray-600 mt-2 leading-relaxed","children":"Ossiculoplasty may improve hearing in appropriately selected patients. The amount of improvement varies depending on the condition of the middle and inner ear and the underlying cause of hearing loss."}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-lg font-semibold","children":"Is ossiculoplasty the same as tympanoplasty?"}],["$","p",null,{"className":"text-gray-600 mt-2 leading-relaxed","children":"No. Tympanoplasty primarily repairs a damaged or perforated eardrum, while ossiculoplasty reconstructs the middle-ear ossicles. Both procedures may sometimes be performed during the same ear operation."}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-lg font-semibold","children":"How is ossicular damage diagnosed?"}],["$","p",null,{"className":"text-gray-600 mt-2 leading-relaxed","children":"ENT examination, microscopic ear examination and hearing tests such as pure tone audiometry and tympanometry may be used. Additional investigations may be recommended when clinically necessary."}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-lg font-semibold","children":"How long does hearing improvement take after ossiculoplasty?"}],["$","p",null,{"className":"text-gray-600 mt-2 leading-relaxed","children":"Hearing improvement may occur gradually after surgery as the middle ear heals. The timing varies according to the surgical procedure and individual recovery."}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-lg font-semibold","children":"What is the cost of ossiculoplasty in Delhi?"}],["$","p",null,{"className":"text-gray-600 mt-2 leading-relaxed","children":"The cost varies according to the complexity of the ear condition, surgical technique, hospital or surgical facility, investigations, anaesthesia and follow-up requirements. A personalised estimate can be provided after clinical evaluation."}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-lg font-semibold","children":"When should I see an ENT doctor for hearing loss?"}],["$","p",null,{"className":"text-gray-600 mt-2 leading-relaxed","children":"You should consult an ENT specialist for persistent, worsening or one-sided hearing loss, recurrent ear discharge, repeated ear infections, hearing loss after trauma or sudden changes in hearing."}]]}]]}]]}]
