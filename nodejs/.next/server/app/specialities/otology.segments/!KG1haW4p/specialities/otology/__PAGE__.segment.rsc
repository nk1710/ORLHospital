2:T91c,{"@context":"https://schema.org","@type":"MedicalClinic","name":"Dr. Dhirendra Singh Kushwah ENT & Otology Clinic","url":"https://www.drdhirendrasinghkushwah.in","image":"https://www.drdhirendrasinghkushwah.in/images/gallery/9.webp","logo":"https://www.drdhirendrasinghkushwah.in/.png","description":"Expert Otology care in Delhi, India. Dr. Dhirendra Singh Kushwah specializes in diagnosing and treating ear conditions, hearing loss, tinnitus, vertigo, eardrum perforations, and congenital ear disorders, using advanced ear surgery techniques.","address":{"@type":"PostalAddress","streetAddress":"Jasola Vihar, Arjun Nagar","addressLocality":"New Delhi","postalCode":"110025","addressCountry":"IN"},"telephone":"+91-9311449825","medicalSpecialty":["Otology","Ear Surgery","Hearing Disorders","Balance Disorders"],"founder":{"@type":"Physician","name":"Dr. Dhirendra Singh Kushwah","image":"https://www.drdhirendrasinghkushwah.in/images/gallery/11.webp","description":"Renowned Otology Specialist in India with over 25 years of experience in diagnosing and treating complex ear conditions, hearing loss, vertigo, tinnitus, and performing ear surgeries.","alumniOf":"Jiwaji University, Gwalior","medicalSpecialty":["Otology","ENT","Ear Surgery"],"availableService":[{"@type":"MedicalProcedure","name":"Tympanoplasty","description":"Surgical repair of perforated eardrum to restore hearing and prevent infection."},{"@type":"MedicalProcedure","name":"Mastoid Surgery","description":"Treatment of chronic ear infections and cholesteatoma in the mastoid bone."},{"@type":"MedicalProcedure","name":"Stapedectomy","description":"Surgical procedure to improve hearing in patients with otosclerosis."},{"@type":"MedicalProcedure","name":"Ossiculoplasty","description":"Reconstruction of the small bones of the middle ear to restore hearing."},{"@type":"MedicalProcedure","name":"Cochlear Implant Support","description":"Comprehensive management and follow-up for cochlear implant patients."}],"treatsC