2:Tc87,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Who is Dr.(Prof.) Dhirendra Singh Kushwah?","acceptedAnswer":{"@type":"Answer","text":"Dr.(Prof.) Dhirendra Singh Kushwah is a distinguished Senior Consultant ENT Specialist and Skull Base Surgeon with over 25 years of clinical and academic practice. He currently serves as Head of the ENT Department at ORL International Group of Hospitals, New Delhi."}},{"@type":"Question","name":"Where are Dr. Kushwah's hospital and clinics located?","acceptedAnswer":{"@type":"Answer","text":"Dr. Kushwah consults at ORL International Group of Hospitals (Plot 89, Pocket 1, Jasola Vihar), ORL International Clinic (J-1981, CR Park), Gynae & ENT Speciality Clinic (19 C Arjun Nagar, Safdarjung Enclave), and regional hospital centres in Palwal and Dhampur."}},{"@type":"Question","name":"What core ENT services and surgeries are offered?","acceptedAnswer":{"@type":"Answer","text":"Comprehensive services include Microscopic Ear Surgery (Tympanoplasty, Mastoidectomy, Stapedotomy, Ossiculoplasty), Cochlear & Hearing Implants, Functional Endoscopic Sinus Surgery (FESS), Pain-Free Packless Septoplasty, Coblation Tonsillectomy & Adenoidectomy, Skull Base Surgery, and Dizziness/Vertigo Clinic."}},{"@type":"Question","name":"What is 'Packless' Septoplasty and how does it benefit patients?","acceptedAnswer":{"@type":"Answer","text":"Packless Septoplasty is a modern surgical technique where quilting sutures or internal splints are used instead of painful traditional nasal ribbon gauze packs. Patients wake up breathing freely through both nostrils with virtually zero post-operative pain and no traumatic packing removal."}},{"@type":"Question","name":"How can I book an appointment with Dr. Kushwah?","acceptedAnswer":{"@type":"Answer","text":"You can book directly by calling our 24x7 OPD desk at +91-9311449825 or by completing the online appointment request form on our website."}},{"@type":"Question","name":"Does the hospital accept cashless health insurance and TPAs?","acceptedAnswer":{"@type":"Answer","text":"Yes, ORL International Group of Hospitals provides cashless insurance pre-authorization with all major national health insurance providers, TPAs, and corporate panels."}},{"@type":"Question","name":"What are the clinic timings across centres?","acceptedAnswer":{"@type":"Answer","text":"Jasola Hospital: Mon-Sun 9:30 AM to 3:00 PM; CR Park Clinic: Mon-Sat 6:30 PM to 9:00 PM; Safdarjung Enclave: Mon-Sun 4:00 PM to 5:00 PM. Palwal and Dhampur centres operate on designated days by prior appointment."}},{"@type":"Question","name":"What should I bring for my first clinical consultation?","acceptedAnswer":{"@type":"Answer","text":"Please bring your past medical records, previous audiological hearing tests (pure tone audiogram/impedance), sinus CT scans or MRI reports, and a list of current medications."}},{"@type":"Question","name":"Are telemedicine or online video second opinions available?","acceptedAnswer":{"@type":"Answer","text":"Yes, remote video consultations are available for outstation and international patients seeking second surgical opinions or post-operative follow-up guidance."}}]}0:{"buildId":"build-1792603351652","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"],["$L5"],"$L6"]}],"loading":null,"isPartial":false}
