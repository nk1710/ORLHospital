RewriteEngine On

# Force HTTPS + www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.drdhirendrasinghkushwah\.in$ [NC]
RewriteRule ^ https://www.drdhirendrasinghkushwah.in%{REQUEST_URI} [R=301,L]

RewriteRule ^\.builds - [F,L]

PassengerAppRoot /home/u337227193/domains/drdhirendrasinghkushwah.in/hbuilds/current/nodejs
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs22/root/bin/node
PassengerStartupFile server.js
PassengerBaseURI /
PassengerRestartDir /home/u337227193/domains/drdhirendrasinghkushwah.in/hbuilds/current/nodejs/tmp
SetEnv NODE_OPTIONS "--require /home/u337227193/domains/drdhirendrasinghkushwah.in/hbuilds/config/preload-timestamp.js"
SetEnv LSNODE_CONSOLE_LOG console.log
SetEnv TOKIO_WORKER_THREADS 2